{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,

    // Enforces the cross-version discipline mechanically: every type-only
    // import from @deepseek-ai/* MUST be written as `import type`, which the
    // compiler then erases. This guarantees a plugin never resolves a second
    // runtime copy of a DSH package (three harness cohorts coexist on a
    // typical machine — see docs/planning/PLAN.md 2.12 #16).
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests"]
}
