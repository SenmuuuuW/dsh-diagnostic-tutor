{
  "compilerOptions": {
    "target": "ES2023",
    // DOM is needed by the browser half under src/client. The host build
    // (tsconfig.build.json) narrows this back to ES2023 only, so host code
    // reaching for a DOM global fails the build rather than the typecheck.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",

    // Enforces the cross-version discipline mechanically: every type-only
    // import from @deepseek-ai/* MUST be written as `import type`, which the
    // compiler then erases. This guarantees a plugin never resolves a second
    // runtime copy of a DSH package (three harness cohorts coexist on a
    // typical machine — see docs/planning/PLAN.md 2.12 #16).
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src", "tests"]
}
