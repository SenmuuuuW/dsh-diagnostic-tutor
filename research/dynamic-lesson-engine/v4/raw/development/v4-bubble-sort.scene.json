  "narration": [
    {
      "at": 0.8,
      "text": "Five values in a row. A pass compares neighbours from left to right and swaps any pair that is out of order."
    },
    {
      "at": 3.4,
      "text": "5 meets 1: the two values trade cells, so 5 drifts one step right. Every swap is real work, counted by the red bar."
    },
    {
      "at": 7.2,
      "text": "5 keeps meeting smaller values and keeps moving right; after four comparisons it sits in the last cell."
    },
    {
      "at": 9.8,
      "text": "Pass 1 is over. The largest value is final, and the blue suffix is one cell wide: one cell per pass."
    },
    {
      "at": 11.6,
      "text": "Pass 2 scans from the left again: 3 and 1 swap, then 4 and 2 swap, so 4 settles next to 5."
    },
    {
      "at": 15.6,
      "text": "Two cells are final now. The suffix claims only what a pass actually proved."
    },
    {
      "at": 17.4,
      "text": "Pass 3: 3 and 2 trade once and 3 lands in cell three, so the suffix grows to three cells."
    },
    {
      "at": 20.4,
      "text": "Pass 4 compares the first two cells and swaps nothing. A whole pass with no swap is the proof that the array is sorted."
    },
    {
      "at": 22.0,
      "text": "Final: 1 2 3 4 5 after ten comparisons and six swaps. Bubble sort is correct, not optimal."
    }
  ],
  "fallback": {
    "text": "Static pass-by-pass table for [3, 5, 1, 4, 2]. Pass 1 compares 3-5 (no swap), 5-1, 5-4, 5-2 (three swaps) giving [3, 1, 4, 2, 5], so 5 is final and the sorted suffix is 1 cell. Pass 2: 3-1 swap, 3-4 no, 4-2 swap, giving [1, 3, 2, 4, 5] and a 2-cell suffix. Pass 3: 1-3 no, 3-2 swap, giving [1, 2, 3, 4, 5] and a 3-cell suffix. Pass 4: 1-2 no swap, so the whole array is declared sorted. Totals: 10 adjacent comparisons, 6 swaps. The suffix grows one cell per pass, never all at once."
  },
  "accessibility": {
    "alt": "Five number cards in a row. A red box slides right along adjacent pairs; when the left card is larger the two cards cross, one arcing above the row and one below, and swap places. A blue band grows from the right after each pass, and a red bar at the lower left lengthens by one step at every swap.",
    "reducedMotion": "Show five static rows, one per pass state, labelled 'start', 'after pass 1', 'after pass 2', 'after pass 3', 'pass 4: no swaps'. Each row shades the final suffix and prints the running total of swaps beneath it.",
    "keyboard": true
  },
