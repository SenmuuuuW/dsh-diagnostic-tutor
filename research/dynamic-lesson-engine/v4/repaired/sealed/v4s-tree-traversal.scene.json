  "narration": [
    {
      "at": 0.9,
      "text": "Inorder means: finish the left subtree, then visit the node, then the right subtree. The red ring marks the node being handled."
    },
    {
      "at": 3,
      "text": "At A the traversal descends left to B before touching A. The thick edges are the current call path, the recursion stack."
    },
    {
      "at": 5.6,
      "text": "At D there is no left child, so D is output first; the ring then returns to B."
    },
    {
      "at": 8,
      "text": "B's left subtree is finished, so B is output before its right child E: inorder puts the node between the two subtrees."
    },
    {
      "at": 10.4,
      "text": "Back at A, the whole left subtree is done, so A is output now, and then the right subtree starts."
    },
    {
      "at": 12.8,
      "text": "C is last. Every node appears exactly once. Sorted output would need a binary search tree; these letters are labels, not keys."
    }
  ],
  "fallback": {
    "text": "Static tree with root A, left child B, right child C, and B's children D and E. The inorder sequence is D, B, E, A, C: descend to the leftmost node D, output it, return to B and output it, visit B's right child E, then output A, then output C. The call path from the root, A to B to D, is the recursion stack at the deepest point. Caption: left subtree, node, right subtree; every node exactly once; sorted order only if the tree is a binary search tree."
  },
  "accessibility": {
    "alt": "A five-node binary tree with root A, left child B, right child C, and B's children D and E. A red ring moves from node to node along the recursion path: A, then B, then D, back to B, then E, back to A, then C. A thick path from the root shows the current recursion stack. A row of blue letters at the",
    "reducedMotion": "static",
    "keyboard": true
  },
