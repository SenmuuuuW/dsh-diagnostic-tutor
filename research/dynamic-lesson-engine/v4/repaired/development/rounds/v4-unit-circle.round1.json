  "metadata": {
    "title": "Unit circle and the sine function",
    "subject": "Mathematics",
    "topic": "Unit Circle and Sine",
    "objective": "Connect a point moving on a unit circle to the height of the sine function.",
    "learner": "Knows right-triangle sine but not the circular interpretation.",
    "misconceptions": [
      "Sine is only a triangle ratio"
    ],
    "expectedUnderstanding": [
      "sin θ is the y-coordinate of the point at angle θ on the unit circle",
      "θ runs over every angle, so the height is read straight off the circle",
      "Past the first quadrant the height can be zero or negative, and sine follows it"
    ]
  },
