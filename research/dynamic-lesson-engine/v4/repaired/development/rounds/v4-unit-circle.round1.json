  "checkpoints": [
    {
      "at": 8.5,
      "prompt": "The point has almost completed a half turn. Predict the height when it reaches θ = π.",
      "learnerAction": "answer"
    },
    {
      "at": 17.5,
      "prompt": "Confirm: the red segment is the y-coordinate of the point itself, so sin θ exists for every angle, not just inside a right triangle.",
      "learnerAction": "continue"
    }
  ],
  "narration": [
    {
      "at": 0.4,
      "text": "The point starts at θ = 0, on the right of the circle: its height is 0."
    },
    {
      "at": 4.6,
      "text": "As the angle grows, the red height above the horizontal axis is copied straight across to the sine graph."
    },
    {
      "at": 9.0,
      "text": "At θ = π the point is back on the axis, so the height and sin π are both 0."
    },
    {
      "at": 13.6,
      "text": "Below the axis the height is negative, and the sine curve goes below zero too."
    }
  ],
  "fallback": {
    "text": "Static figure: a unit circle with a point at angle θ, the vertical segment from the point to the horizontal axis marked as its height, and beside it the graph of y = sin θ on the same vertical scale. At θ = 0, π/2, π, 3π/2 the heights are 0, 1, 0, −1, so sin π = 0."
  },
  "accessibility": {
    "alt": "A point travels anticlockwise round a unit circle from the rightmost point. A red segment shows its height above the horizontal axis, a dashed red line copies that height across to a sine curve plotted beside it, and a red dot traces the curve as the point moves.",
    "reducedMotion": "Freeze the point at θ = π/4, π/2, π and 3π/2 and draw the four height segments and the four curve points at once, plus the label of each height value.",
    "keyboard": true
  },
  "sourceRefs": [
    "case:v4-unit-circle"
  ]
