  "metadata": {
    "title": "Binary search keeps the target inside the window",
    "subject": "Computer Science",
    "topic": "Binary Search Invariant",
    "objective": "Show that each step preserves the target inside the active interval.",
    "learner": "Can trace loops.",
    "misconceptions": [
      "Every midpoint is the answer",
      "The interval can exclude the target"
    ],
    "expectedUnderstanding": "The invariant is that the target, if present, always lies in [lo, hi]. A midpoint probe compares one value and discards exactly the half that cannot contain the target, so the window halves without ever losing it, and the search ends when lo past hi or a midpoint equals the target."
  },
