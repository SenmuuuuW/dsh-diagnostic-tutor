  "metadata": {
    "title": "Graph Traversal: BFS vs DFS",
    "subject": "Computer Science",
    "objective": "Show BFS/DFS visiting order and frontier differences.",
    "learner": "Knows nodes and edges.",
    "misconceptions": [
      "DFS always finds the shortest path in an unweighted graph",
      "Visited nodes can be revisited forever"
    ],
    "expectedUnderstanding": [
      "BFS explores level by level with a queue, while DFS follows one branch with a stack.",
      "The visited set grows and each node is visited once.",
      "BFS gives shortest unweighted path distances, while DFS order can go deep before returning."
    ]
  },
