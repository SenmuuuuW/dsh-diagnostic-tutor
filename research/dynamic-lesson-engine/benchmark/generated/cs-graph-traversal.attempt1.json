  "checkpoints": [
    {
      "t": 0,
      "label": "Start at A. The frontier contains A."
    },
    {
      "t": 2,
      "label": "BFS visits A. Its queue adds B and C."
    },
    {
      "t": 4,
      "label": "BFS visits B. Its queue frontier becomes C, D, E."
    },
    {
      "t": 6,
      "label": "BFS visits C. Frontier is D, E."
    },
    {
      "t": 8,
      "label": "BFS visits D. Frontier is E."
    },
    {
      "t": 10,
      "label": "BFS visits E. All five nodes are visited once."
    }
  ],
  "narration": [
    {
      "t": 0,
      "text": "Start at A. BFS will use a queue, so it explores level by level."
    },
    {
      "t": 2,
      "text": "Visit A. Its neighbors B and C enter the queue. DFS would follow B first instead of finishing the level."
    },
    {
      "t": 4,
      "text": "Visit B. Its unvisited neighbors D and E enter the queue, behind C."
    },
    {
      "t": 6,
      "text": "Visit C. It adds no new nodes, so the frontier is D and E."
    },
    {
      "t": 8,
      "text": "Visit D. E remains next for BFS."
    },
    {
      "t": 10,
      "text": "Visit E. The BFS order is A, B, C, D, E. Switch mode to compare the DFS order A, B, D, E, C. Each node appears once."
    }
  ],
  "fallback": {
    "text": "Graph with edges A-B, A-C, B-D, B-E, E-C. BFS visits A, B, C, D, E using a queue; DFS visits A, B, D, E, C using a stack."
  },
  "accessibility": {
    "alt": "A graph with nodes A through E and edges A-B, A-C, B-D, B-E, E-C. BFS order A, B, C, D, E and DFS order A, B, D, E, C appear as two rows. A green visited band advances along the active row as mode switches.",
