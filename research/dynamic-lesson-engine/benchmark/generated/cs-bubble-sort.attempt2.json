  "metadata": {
    "title": "Bubble Sort: Adjacent Swaps",
    "subject": "Computer Science",
    "objective": "Show why bubble sort compares only neighbours and needs more than one pass.",
    "learner": "Can read a simple loop and array indices.",
    "misconceptions": [
      "One pass always sorts the whole array",
      "Bubble sort compares values that are far apart"
    ],
    "expectedUnderstanding": [
      "Bubble sort compares each adjacent pair and swaps only when the left value is larger.",
      "Each pass moves the largest remaining value to the right edge and grows the sorted suffix.",
      "The array 3, 2, 1 needs two passes, so passes repeat until no swap is needed."
    ]
  },
