  "checkpoints": [
    {
      "id": "cp-bubble-start",
      "at": 0,
      "title": "Start with 3, 2, 1",
      "body": "The array is 3, 2, 1. Bubble sort never jumps: it looks at the first adjacent pair, 3 and 2.",
      "pause": true
    },
    {
      "id": "cp-bubble-first-swap",
      "at": 2,
      "title": "Swap only when the left value is larger",
      "body": "3 is greater than 2, so the pair swaps and the array becomes 2, 3, 1. The scan moves one slot right and compares 3 with 1.",
      "pause": true
    },
    {
      "id": "cp-bubble-pass-one",
      "at": 5,
      "title": "Pass 1 locks the largest value at the edge",
      "body": "3 is greater than 1, so they swap and the array becomes 2, 1, 3. The 3 has reached the right edge, so the green suffix starts at the last slot.",
      "pause": true
    },
    {
      "id": "cp-bubble-pass-two",
      "at": 7,
      "title": "One pass was not enough",
      "body": "Pass 2 compares 2 and 1 and swaps them, giving 1, 2, 3. After pass 1 the array was still 2, 1, 3, so passes must repeat until a pass makes no swap.",
      "pause": true
    },
    {
      "id": "cp-bubble-done",
      "at": 8.2,
      "title": "A final pass finds no inversion",
      "body": "Every adjacent pair is now in order, so the loop stops. The sorted suffix covers the whole array.",
      "pause": false
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "Start with 3, 2, 1. Bubble sort only compares neighbours, so it begins with 3 and 2."
    },
    {
      "at": 2,
      "text": "3 is greater than 2, so they swap. The scan moves right and compares 3 with 1."
    },
    {
      "at": 5,
      "text": "3 is greater than 1, so they swap. Pass 1 ends with 3 locked at the right edge."
    },
    {
      "at": 7,
      "text": "Pass 2 compares 2 and 1 and swaps them, so the array becomes 1, 2, 3."
    },
    {
      "at": 8.2,
      "text": "A final pass finds no inversion, so the sorted suffix covers the whole array."
    }
  ],
  "fallback": {
    "text": "Array 3, 2, 1. Bubble sort compares adjacent values and swaps them when the left one is larger: 3 and 2 swap, then 3 and 1 swap, giving 2, 1, 3. A second pass swaps 2 and 1 to give 1, 2, 3, and a final pass finds no inversion."
  },
  "accessibility": {
    "alt": "Three numbered tokens 3, 2 and 1 sit in slots. Tokens swap places as adjacent pairs are compared, and a green band grows from the right edge until all three slots are marked as the sorted suffix.",
    "reducedMotion": "no-autoplay",
    "keyboard": true
  }
}
