  "checkpoints": [
    {
      "t": 0,
      "label": "low=0, high=5, mid=2. A[2]=8 is below 12."
    },
    {
      "t": 3,
      "label": "Discard indices 0 to 2. low=3, high=5, mid=4."
    },
    {
      "t": 6,
      "label": "A[4]=16 is above 12. Discard indices 4 and 5. high=3."
    },
    {
      "t": 9,
      "label": "low=high=3. A[3]=12, so the search returns index 3."
    }
  ],
  "narration": [
    {
      "t": 0,
      "text": "The input is sorted: 2, 5, 8, 12, 16, 23. Search for 12 with low 0, high 5, and mid 2."
    },
    {
      "t": 3,
      "text": "8 is below 12. Because the array is sorted, everything at or left of mid is too small, so low moves to 3."
    },
    {
      "t": 6,
      "text": "Now mid is 4 and the value is 16. It is above 12, so high moves left to 3. The right half is excluded."
    },
    {
      "t": 9,
      "text": "low and high meet at index 3. The midpoint value is 12, so the result is index 3."
    }
  ],
  "fallback": {
    "text": "Sorted array 2, 5, 8, 12, 16, 23. Low, high, and mid shrink the interval until index 3 contains target 12."
  },
  "accessibility": {
    "alt": "A sorted array 2, 5, 8, 12, 16, 23 with target 12. Low, mid, and high labels move as whole halves dim out. The interval narrows until all three meet at index 3, where 12 is found.",
