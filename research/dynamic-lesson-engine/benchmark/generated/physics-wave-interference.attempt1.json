  "checkpoints": [
    {
      "id": "wave-watch",
      "at": 0.8,
      "title": "Watch the three rows",
      "body": "The top row is wave 1, the middle row is wave 2, and the bottom row is their sum at the same positions. The individual waves keep moving even when the sum is zero.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "wave-phase",
      "at": 2.3,
      "title": "Change the phase",
      "body": "At a phase of 0 degrees the waves are in step and the sum has twice the displacement. At 180 degrees a peak meets a trough and the sum sits on the baseline.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "wave-check",
      "at": 4.0,
      "title": "Check the energy claim",
      "body": "When the sum is zero at these points, has the energy been destroyed? No. The waves still carry energy; interference redistributes it. The waves do not stop existing, and they do not cancel each other out of existence.",
      "pause": true,
      "learnerAction": "answer"
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "Two waves oscillate at the same points. The bottom row adds their displacements."
    },
    {
      "at": 1.2,
      "text": "With zero phase shift, peaks meet peaks and troughs meet troughs. The sum is larger."
    },
    {
      "at": 2.4,
      "text": "Set the phase to 180 degrees. A peak meets a trough, so the sum is zero at these positions."
    },
    {
      "at": 3.6,
      "text": "The cancellation is local. The waves still exist and still carry energy; the energy is redistributed."
    }
  ],
  "fallback": {
    "text": "Two waves with a controllable phase shift are added at several positions. In phase, their displacements add. At 180 degrees out of phase, a peak meets a trough and the sum is zero at the observed points. The individual waves continue, and their energy is redistributed rather than destroyed."
  },
  "accessibility": {
    "alt": "Three labeled rows of dots show wave 1, wave 2, and their sum. The dots oscillate vertically; the sum doubles when in phase and flattens at 180 degrees. A note says cancellation redistributes energy rather than destroying it.",
    "reducedMotion": "no-autoplay",
    "keyboard": true
  }
}
