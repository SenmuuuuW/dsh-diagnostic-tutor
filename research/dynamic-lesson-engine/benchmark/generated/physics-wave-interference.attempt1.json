  "metadata": {
    "title": "Wave Interference: Adding Two Waves",
    "subject": "Physics",
    "objective": "Show constructive and destructive interference as two waves combine.",
    "learner": "Knows wave peaks and troughs.",
    "misconceptions": [
      "Waves cancel by destroying energy",
      "Interference means the waves stop existing"
    ],
    "expectedUnderstanding": [
      "In-phase waves add to a larger displacement.",
      "Opposite-phase waves cancel at the observation points while the individual waves continue.",
      "A phase shift changes whether interference is constructive or destructive.",
      "Cancellation redistributes energy rather than destroying it."
    ]
  },
