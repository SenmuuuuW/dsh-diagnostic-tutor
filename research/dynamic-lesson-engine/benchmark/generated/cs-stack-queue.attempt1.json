  "checkpoints": [
    {
      "t": 0,
      "label": "Both structures are empty. The input sequence is 4, 7, 9."
    },
    {
      "t": 2,
      "label": "Push 4 and enqueue 4."
    },
    {
      "t": 4,
      "label": "Push 7 and enqueue 7. Stack top is 7; queue front is 4."
    },
    {
      "t": 6,
      "label": "Push 9 and enqueue 9. Stack top is 9; queue front is still 4."
    },
    {
      "t": 8,
      "label": "Pop removes 9 from the stack. Dequeue removes 4 from the queue."
    }
  ],
  "narration": [
    {
      "t": 0,
      "text": "Both structures start empty. The same input sequence, 4 then 7 then 9, will be inserted into each."
    },
    {
      "t": 2,
      "text": "4 is pushed onto the stack and enqueued at the back of the queue."
    },
    {
      "t": 4,
      "text": "7 is added. The stack top is now 7, but the queue front is still 4."
    },
    {
      "t": 6,
      "text": "9 is added. The stack holds 4, 7, 9 with 9 on top. The queue holds 4, 7, 9 with 4 at the front."
    },
    {
      "t": 8,
      "text": "Pop takes the most recent item, 9. Dequeue takes the oldest item, 4. The same input produced different removal orders."
    }
  ],
  "fallback": {
    "text": "A stack and a queue each receive 4, 7, 9. Pop removes 9 from the stack, while dequeue removes 4 from the queue."
  },
  "accessibility": {
    "alt": "A stack and a queue each receive 4, 7, and 9 in that order. The stack grows upward with 9 on top; the queue lines up with 4 at the front. On removal, the stack releases 9 while the queue releases 4, and both move to a removed row.",
    "reducedMotion": true,
    "keyboard": true
  }
