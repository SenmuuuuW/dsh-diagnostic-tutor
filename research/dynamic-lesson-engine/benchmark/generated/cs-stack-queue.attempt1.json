  "metadata": {
    "title": "Stack vs Queue",
    "subject": "Computer Science",
    "objective": "Contrast LIFO and FIFO operations with the same sequence.",
    "learner": "Knows a list.",
    "misconceptions": [
      "Stacks and queues are the same structure",
      "The first inserted item is always removed first"
    ],
    "expectedUnderstanding": [
      "A stack pushes and pops at the same end, giving last-in, first-out order.",
      "A queue enqueues at the back and dequeues at the front, giving first-in, first-out order.",
      "The same input sequence produces different removal orders in the two structures."
    ]
  },
