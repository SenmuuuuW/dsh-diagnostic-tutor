  "checkpoints": [
    {
      "id": "cp-binary-mid",
      "at": 0,
      "title": "Compare with the midpoint",
      "body": "The sorted array is 4, 8, 12, 16, 20 and the target is 8. Low is index 0, high is index 4, so mid is index 2 and holds 12.",
      "pause": true
    },
    {
      "id": "cp-binary-right-discard",
      "at": 3,
      "title": "Discard the right half",
      "body": "12 is greater than 8, and the array is sorted, so index 2 and everything to its right is too large. High moves to 1: only indices 0 and 1 remain.",
      "pause": true
    },
    {
      "id": "cp-binary-left-discard",
      "at": 5,
      "title": "Discard the left half",
      "body": "Now low is 0, high is 1 and mid is 0. The value 4 is smaller than 8, so index 0 is too small and low moves to 1. Only index 1 remains.",
      "pause": true
    },
    {
      "id": "cp-binary-found",
      "at": 7,
      "title": "The bounds meet at the answer",
      "body": "Low, mid and high all equal index 1, whose value is 8. If the target were missing, the loop would stop as soon as low passes high.",
      "pause": false
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "The input is sorted: 4, 8, 12, 16, 20. Search for 8 with low 0, high 4 and mid 2."
    },
    {
      "at": 3,
      "text": "The midpoint holds 12, which is greater than 8. Because the array is sorted, the right half is discarded and high moves to 1."
    },
    {
      "at": 5,
      "text": "Mid is now index 0 with value 4. It is smaller than 8, so index 0 is discarded and low moves to 1."
    },
    {
      "at": 7,
      "text": "Low, mid and high meet at index 1. The value there is 8, so the search returns index 1."
    }
  ],
  "fallback": {
    "text": "Sorted array 4, 8, 12, 16, 20 with target 8. The midpoint 12 is too large, so the right half is discarded; the new midpoint 4 is too small, so index 0 is discarded. Low and high meet at index 1, which holds the target 8."
  },
  "accessibility": {
    "alt": "A sorted array 4, 8, 12, 16, 20 with target 8. Low, mid and high labels shift as whole halves dim out, first the right half from 12 onward and then index 0. The bounds converge on index 1, where 8 is found.",
    "reducedMotion": "no-autoplay",
    "keyboard": true
  }
}
