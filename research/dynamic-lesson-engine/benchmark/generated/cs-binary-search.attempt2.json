  "metadata": {
    "title": "Binary Search: Sorted Input",
    "subject": "Computer Science",
    "objective": "Show the bounds shrinking and why a sorted array is required.",
    "learner": "Can read array indices.",
    "misconceptions": [
      "Binary search works on any array",
      "The midpoint is always the answer"
    ],
    "expectedUnderstanding": [
      "Binary search keeps a low and a high bound around the remaining interval.",
      "A midpoint comparison discards one whole half because the input is sorted.",
      "The search stops when the target is found or when low passes high."
    ]
  },
