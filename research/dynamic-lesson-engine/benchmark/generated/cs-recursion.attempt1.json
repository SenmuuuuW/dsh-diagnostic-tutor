  "checkpoints": [
    {
      "t": 0,
      "label": "The stack is empty. fact(3) is called."
    },
    {
      "t": 2,
      "label": "Push fact(3). It waits for fact(2)."
    },
    {
      "t": 4,
      "label": "Push fact(2). It waits for fact(1)."
    },
    {
      "t": 6,
      "label": "Push fact(1). It waits for fact(0)."
    },
    {
      "t": 8,
      "label": "fact(0) is the base case, so the descent stops."
    },
    {
      "t": 9.6,
      "label": "fact(0) returns 1. The newest frame pops first."
    },
    {
      "t": 11,
      "label": "fact(1) returns 1; fact(2) can now return 2."
    },
    {
      "t": 12.4,
      "label": "fact(2) returns 2; fact(3) can now return 6."
    },
    {
      "t": 13.8,
      "label": "fact(3) returns 6. The stack is empty."
    }
  ],
  "narration": [
    {
      "t": 0,
      "text": "Call fact(3). The call stack is empty."
    },
    {
      "t": 2,
      "text": "Push fact(3). It cannot finish until fact(2) returns."
    },
    {
      "t": 4,
      "text": "Push fact(2). It waits for fact(1)."
    },
    {
      "t": 6,
      "text": "Push fact(1). It waits for fact(0)."
    },
    {
      "t": 8,
      "text": "fact(0) matches the base case. No deeper call is made, so the descent stops."
    },
    {
      "t": 9.6,
      "text": "fact(0) returns 1. The top frame pops, and the stack unwinds."
    },
    {
      "t": 11,
      "text": "fact(1) returns 1, so fact(2) computes 2 times 1 and returns 2."
    },
    {
      "t": 12.4,
      "text": "fact(2) returns 2, so fact(3) computes 3 times 2 and returns 6."
    },
    {
      "t": 13.8,
      "text": "The last frame returns 6. Unwinding followed last-in, first-out order."
    }
  ],
  "fallback": {
    "text": "factorial(3) pushes fact(3), fact(2), fact(1), then fact(0). The base case returns 1, and the frames pop in LIFO order with values 1, 1, 2, and 6."
  },
  "accessibility": {
    "alt": "Four call frames for factorial(3) slide onto a stack in call order. The newest frame, fact(0), reaches the base case and returns 1 first; then frames move to a return column showing 1, 2, and 6 in LIFO order.",
