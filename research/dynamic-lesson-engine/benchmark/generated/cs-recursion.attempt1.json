  "metadata": {
    "title": "Recursion: Call Stack",
    "subject": "Computer Science",
    "objective": "Show the call stack growing and unwinding for a recursive function.",
    "learner": "Can read a simple function.",
    "misconceptions": [
      "Recursion runs all calls simultaneously",
      "The base case is executed first"
    ],
    "expectedUnderstanding": [
      "A recursive call adds a frame to the call stack and waits for its result.",
      "The base case stops the descent before any return value is produced.",
      "Frames return in last-in, first-out order and pass values back up the stack."
    ]
  },
  "properties": [
    {
      "id": "step",
      "label": "Call stack step",
