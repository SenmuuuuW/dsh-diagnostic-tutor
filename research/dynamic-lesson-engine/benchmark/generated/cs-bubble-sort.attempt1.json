  "checkpoints": [
    {
      "t": 0,
      "label": "Start [3, 2, 1]. Compare 3 and 2."
    },
    {
      "t": 2,
      "label": "Swap 3 and 2. The array is [2, 3, 1]."
    },
    {
      "t": 5.2,
      "label": "Swap 3 and 1. Pass 1 ends with 3 fixed: [2, 1, 3]."
    },
    {
      "t": 8.4,
      "label": "Pass 2 swaps 2 and 1: [1, 2, 3]."
    },
    {
      "t": 11.4,
      "label": "Verification finds no adjacent inversion. Sorted."
    }
  ],
  "narration": [
    {
      "t": 0,
      "text": "Start with 3, 2, 1. Compare the first adjacent pair."
    },
    {
      "t": 2,
      "text": "3 is greater than 2, so they swap. The scan moves right."
    },
    {
      "t": 5.2,
      "text": "3 is greater than 1, so they swap. Pass 1 ends and 3 is locked at the right."
    },
    {
      "t": 8.4,
      "text": "Pass 2 compares 2 and 1. They swap, so the array becomes 1, 2, 3."
    },
    {
      "t": 11.4,
      "text": "A final pass finds no inversion. The sorted suffix now covers the whole array."
    }
  ],
  "fallback": {
    "text": "Array 3, 2, 1. Bubble sort swaps adjacent out-of-order values pass by pass until 1, 2, 3 remains."
  },
