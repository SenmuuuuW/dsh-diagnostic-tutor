  "metadata": {
    "title": "Bubble Sort: Adjacent Swaps",
    "subject": "Computer Science",
    "objective": "Show adjacent swaps and the growing sorted suffix.",
    "learner": "Can read a loop.",
    "misconceptions": [
      "One pass always sorts the whole array",
      "Bubble sort starts from the middle"
    ],
    "expectedUnderstanding": [
      "Bubble sort compares adjacent values and swaps only when the left value is larger.",
      "Each pass moves the largest remaining value to the right and grows the sorted suffix.",
      "A single pass may not sort the whole array, so passes repeat until no swap is needed."
    ]
  },
