  ],
  "checkpoints": [
    {
      "id": "incline-orient",
      "at": 0.7,
      "title": "Find the two directions",
      "body": "The red arrow is weight, mg, straight down. The orange arrow is the part of weight along the slope; the violet arrow is the part perpendicular to the slope.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "incline-components",
      "at": 2.4,
      "title": "Connect angle to components",
      "body": "As the incline steepens, mg sinθ grows and mg cosθ shrinks. The teal normal force is equal and opposite to the perpendicular component, so N = mg cosθ.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "incline-check",
      "at": 4.4,
      "title": "Check the claims",
      "body": "At 60 degrees, is the normal force still equal to mg? No; it is mg cos60, half of mg. Is friction always equal to weight? No; friction depends on the surfaces and the normal force, not directly on mg alone.",
      "pause": true,
      "learnerAction": "answer"
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "Gravity always points straight down. On an incline, we split it into a component along the slope and a component perpendicular to the slope."
    },
    {
      "at": 1.8,
      "text": "The along-slope component is mg sine theta. The perpendicular component is mg cosine theta."
    },
    {
      "at": 3.4,
      "text": "The normal force balances the perpendicular component, so it equals mg cosine theta, not mg at every angle."
    },
    {
      "at": 5,
      "text": "Friction is a separate force. Its size is not generally equal to the weight."
    }
  ],
  "fallback": {
    "text": "On an incline, weight splits into mg sin(theta) along the slope and mg cos(theta) perpendicular to the slope. The normal force balances the perpendicular component and therefore equals mg cos(theta) in this model. Friction is a separate force and is not generally equal to weight."
  },
