  "metadata": {
    "title": "Forces on an Incline",
    "subject": "Physics",
    "objective": "Show how gravity components change with incline angle.",
    "learner": "Knows forces as pushes and pulls.",
    "misconceptions": [
      "Normal force equals weight at every angle",
      "Friction is always equal to weight"
    ],
    "expectedUnderstanding": [
      "The component of gravity along the plane is mg sin(theta).",
      "The component of gravity perpendicular to the plane is mg cos(theta).",
      "The normal force balances the perpendicular component, so it is not always equal to mg.",
      "Friction is a separate force and is not generally equal to weight."
    ]
  },
