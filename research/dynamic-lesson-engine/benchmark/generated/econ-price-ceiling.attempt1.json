  "metadata": {
    "title": "Binding Price Ceiling and Shortage",
    "subject": "Economics",
    "objective": "Show a binding price ceiling below equilibrium and the resulting shortage.",
    "learner": "Knows supply and demand basics.",
    "misconceptions": [
      "A ceiling always helps buyers",
      "Shortage equals zero supply"
    ],
    "expectedUnderstanding": [
      "A ceiling binds only when it is set below the equilibrium price.",
      "At the ceiling, quantity demanded exceeds quantity supplied, creating a shortage.",
      "Shortage equals quantity demanded minus quantity supplied, not zero supply.",
      "A price ceiling does not raise total surplus."
    ]
  },
