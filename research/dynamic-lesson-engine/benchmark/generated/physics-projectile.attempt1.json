  "checkpoints": [
    {
      "id": "projectile-watch",
      "at": 0.6,
      "title": "Watch the shape",
      "body": "The ball rises and falls along the thick orange curve. Change the angle and replay to see how the apex and landing point move.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "projectile-range",
      "at": 2.6,
      "title": "Compare the range",
      "body": "The teal bar measures the horizontal range. At equal launch and landing heights, the red tick at 45 degrees is the farthest landing point.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "projectile-check",
      "at": 4.3,
      "title": "Check the reasoning",
      "body": "Does a larger horizontal speed change the downward acceleration? No. The vertical acceleration stays the same; horizontal speed only changes how far the ball travels. Also, the 45-degree maximum assumes equal launch and landing heights.",
      "pause": true,
      "learnerAction": "answer"
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "A projectile launched at fixed speed follows a parabola. Change the launch angle, then replay."
    },
    {
      "at": 1.2,
      "text": "The vertical acceleration is the same at every angle. Horizontal speed does not change it."
    },
    {
      "at": 2.5,
      "text": "At equal launch and landing heights, the horizontal range peaks at 45 degrees."
    },
    {
      "at": 3.8,
      "text": "The thin curve is the paired angle 90 degrees minus theta. It lands at the same range but reaches a different height."
    }
  ],
  "fallback": {
    "text": "At fixed speed, launch angle sets the projectile's maximum height and range. The path is parabolic, and at equal launch and landing heights the range is greatest at 45 degrees. Angles that add to 90 degrees give equal ranges with different heights."
  },
  "accessibility": {
    "alt": "Projectile at fixed speed arcs from a launch point as the angle slider changes. A thick curve shows the current path, a thin curve the paired angle, and labels mark apex, range, and the 45-degree maximum.",
