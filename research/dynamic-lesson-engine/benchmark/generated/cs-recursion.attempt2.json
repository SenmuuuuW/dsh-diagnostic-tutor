  "metadata": {
    "title": "Recursion: the Call Stack for factorial(3)",
    "subject": "Computer Science",
    "objective": "Show the call stack growing to the base case and unwinding last-in, first-out.",
    "learner": "Can read a simple function and a return statement.",
    "misconceptions": [
      "Recursion runs all calls at the same time",
      "The base case is executed before the deeper calls",
      "The first call returns first"
    ],
    "expectedUnderstanding": [
      "Each recursive call pushes a frame and waits for the call inside it.",
      "The base case makes no deeper call, so it is the first frame to return.",
      "Frames pop in last-in, first-out order and pass values back up the stack."
    ]
  },
