  "checkpoints": [
    {
      "id": "cp-rec-start",
      "at": 0,
      "title": "Calling fact(3) does not answer yet",
      "body": "The stack is empty. A call cannot return until the call inside it returns, so the first thing to watch is what gets pushed.",
      "pause": true
    },
    {
      "id": "cp-rec-push3",
      "at": 1.4,
      "title": "Push fact(3)",
      "body": "fact(3) needs fact(2), so its frame waits on the bottom of the stack. The stack now has one waiting call.",
      "pause": true
    },
    {
      "id": "cp-rec-push2",
      "at": 3.2,
      "title": "Push fact(2)",
      "body": "fact(2) needs fact(1). Two frames are waiting, and neither can return until the newest call finishes.",
      "pause": true
    },
    {
      "id": "cp-rec-push1",
      "at": 5,
      "title": "Push fact(1)",
      "body": "fact(1) needs fact(0). The stack grows upward, and the top frame is always the newest call.",
      "pause": true
    },
    {
      "id": "cp-rec-base",
      "at": 6.8,
      "title": "The base case stops the descent",
      "body": "fact(0) matches the base case, so it makes no deeper call. Only now can a return value be produced.",
      "pause": true
    },
    {
      "id": "cp-rec-return0",
      "at": 8.8,
      "title": "fact(0) returns first",
      "body": "The top frame returns 1 and pops. This is LIFO: the most recently pushed frame is the first to return.",
      "pause": true
    },
    {
      "id": "cp-rec-unwind",
      "at": 11.8,
      "title": "Each frame hands a value upward",
      "body": "fact(1) computes 1 * 1, fact(2) computes 2 * 1, and fact(3) computes 3 * 2. Every frame returns after the frame above it.",
      "pause": true
    },
    {
      "id": "cp-rec-done",
      "at": 13.3,
      "title": "The stack empties with the answer 6",
      "body": "The last frame returns 6, so factorial(3) = 6. The call order was 3, 2, 1, 0 and the return order was 0, 1, 2, 3.",
      "pause": false
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "Call fact(3). The stack is empty, and nothing can return yet."
    },
    {
      "at": 1.4,
      "text": "Push fact(3). It waits for fact(2)."
    },
    {
      "at": 3.2,
      "text": "Push fact(2). It waits for fact(1)."
    },
    {
      "at": 5,
      "text": "Push fact(1). It waits for fact(0). The newest call sits at the top of the stack."
    },
    {
      "at": 6.8,
      "text": "fact(0) is the base case, so it makes no deeper call. The descent stops here."
    },
    {
      "at": 8.8,
      "text": "fact(0) returns 1 and its frame pops. Last in, first out."
    },
    {
      "at": 10.3,
      "text": "fact(1) receives 1, computes 1 * 1, and returns 1."
    },
    {
      "at": 11.8,
      "text": "fact(2) receives 1, computes 2 * 1, and returns 2."
    },
    {
      "at": 13.3,
      "text": "fact(3) receives 2, computes 3 * 2, and returns 6. The stack is empty."
    }
  ],
  "fallback": {
    "text": "factorial(3) pushes fact(3), fact(2), fact(1) and then fact(0). fact(0) is the base case and returns 1 without a deeper call. The frames then pop in last-in, first-out order: fact(1) returns 1, fact(2) returns 2, and fact(3) returns 6."
  },
  "accessibility": {
    "alt": "Four call frames stack upward for factorial(3), with fact(3) at the bottom and fact(0) on top. After fact(0) hits the base case it returns 1 first, then frames pop from the top and return values 1, 2 and 6 appear in order.",
    "reducedMotion": "no-autoplay",
    "keyboard": true
  }
}
