  "metadata": {
    "title": "Electric Field of Two Point Charges",
    "subject": "Physics",
    "objective": "Show the electric field of one or two point charges as direction and magnitude.",
    "learner": "Knows positive and negative charge attracts/repels.",
    "misconceptions": [
      "Field is the same as force on every test charge",
      "Field lines cross"
    ],
    "expectedUnderstanding": [
      "The field points away from a positive charge and toward a negative charge.",
      "Field magnitude decreases with distance from a point charge.",
      "The field at a point is the vector sum of the contributions from both charges.",
      "Field is force per unit charge, so F = qE depends on the test charge; the field does not.",
      "Electric field lines never cross."
    ]
  },
