  "checkpoints": [
    {
      "id": "field-read",
      "at": 0.6,
      "title": "Read the arrows",
      "body": "Each blue arrow is the combined field at the point where it starts. Near the positive charge, the field points away from it; set q₂ negative and the arrows near that charge turn toward it.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "field-distance",
      "at": 2.1,
      "title": "Compare magnitudes",
      "body": "Move the test point and compare the red probe arrow with the blue arrows. Field strength falls with distance from a point charge, and the two charges add as vectors.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "field-check",
      "at": 3.9,
      "title": "Separate field from force",
      "body": "Is the field the same as the force on a test charge? No: F = qE, so the force also depends on the test charge. Do field lines cross? No; at each point the field has one direction, so its lines cannot cross.",
      "pause": true,
      "learnerAction": "answer"
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "The electric field at a point is the force per unit positive charge placed there."
    },
    {
      "at": 1.3,
      "text": "A positive charge makes arrows point away. A negative charge makes them point toward it."
    },
    {
      "at": 2.6,
      "text": "With two charges, add their field vectors. Arrow length falls with distance from each charge."
    },
    {
      "at": 3.8,
      "text": "Field is not the same as force. The force is qE, and field lines never cross."
    }
  ],
  "fallback": {
    "text": "The electric field of a positive point charge points away from it; for a negative charge it points toward it. With two charges, the field at each point is the vector sum of both contributions. Field strength decreases with distance, arrow length represents relative strength, and field lines never cross. Field is force per unit charge, not force itself."
  },
  "accessibility": {
    "alt": "Two labeled point charges with six blue field arrows and a red probe arrow. Sliders move the test point and change charge two's sign; arrows point away from positive and toward negative charge. Labels explain strength and that field is not force.",
