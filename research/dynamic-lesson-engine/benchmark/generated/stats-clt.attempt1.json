  "checkpoints": [
    {
      "at": 0,
      "title": "Start non-normal",
      "body": "The top bars are uniform, not normal. The bottom bars show means of samples of size n; at n equal to 1 they are also uniform."
    },
    {
      "at": 2.5,
      "title": "Increase n",
      "body": "As n grows, the means histogram gains a tall center and short tails, and its spread narrows. The raw uniform bars never change shape."
    },
    {
      "at": 5,
      "title": "Resample and check",
      "body": "Move the resample slider and the sample fluctuates, but the means distribution stays centered near the population mean and becomes more bell-shaped with larger n. The raw data did not become normal."
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "The raw population is uniform, not normal. At a sample size of one, the distribution of sample means is also uniform."
    },
    {
      "at": 2.8,
      "text": "As n grows, the middle of the means histogram rises and the tails fall. The spread narrows. The raw bars stay uniform, so the original data did not become normal."
    },
    {
      "at": 5.6,
      "text": "Resampling changes which sample you get, not the population. With larger n, the means distribution stays centered near the population mean and approaches a bell shape."
    }
  ],
  "fallback": {
    "text": "The raw population is uniform and remains uniform; the data does not become normal. For sample means, small n gives a wide, flat distribution. As n grows, the distribution of means centers near the population mean, its spread narrows, and its shape approaches a bell. Resampling changes the sample, not the population, and the theorem does not require the raw data to be normal."
  },
  "accessibility": {
    "alt": "Top: four equal bars show a uniform raw population. Bottom: seven bars show the distribution of sample means. As the n slider rises, the middle bars grow and the tails shrink toward a bell, while the raw bars stay flat. A resample slider redraws the sample.",
    "reducedMotion": true,
    "keyboard": true
  }
