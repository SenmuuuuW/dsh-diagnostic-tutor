  "controls": [
    {
      "type": "slider",
      "target": "demandShift",
      "label": "Shift demand right",
      "min": 0,
      "max": 100,
      "step": 5
    }
  ],
  "checkpoints": [
    {
      "at": 0,
      "title": "Locate equilibrium",
      "body": "Demand slopes down and supply slopes up. The curves cross at E, the equilibrium price and quantity pair."
    },
    {
      "at": 3,
      "title": "Slide versus shift",
      "body": "A price change is movement along a curve. Income, preferences, or other shifters move the whole demand curve, as the light original and blue shifted curve show."
    },
    {
      "at": 6,
      "title": "Compare equilibria",
      "body": "A rightward demand shift moves E up and right: a higher equilibrium price and quantity. Equilibrium is a balance at one price, not a guarantee that everyone can buy at any price."
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "Demand slopes down and supply slopes up. Their intersection is the equilibrium price and quantity pair."
    },
    {
      "at": 3.2,
      "text": "A price change is movement along a curve. A demand shifter moves the entire curve, shown here as the blue line separating from the light original."
    },
    {
      "at": 6.6,
      "text": "After a rightward demand shift, the intersection moves up and right, so both equilibrium price and quantity rise. This is a balance at one price, not a guarantee that everyone can buy at any price."
    }
  ],
  "fallback": {
    "text": "Demand slopes downward and supply slopes upward. Their intersection is equilibrium. Changing price moves along a curve; changing a demand shifter moves the whole demand curve. A rightward demand shift raises both equilibrium price and quantity. Equilibrium is a single price-quantity balance, not a promise that every buyer can buy at any price."
  },
  "accessibility": {
    "alt": "Graph with price on the vertical axis and quantity on the horizontal. Demand slopes down and supply slopes up, meeting at E. A slider shifts demand right, and the E marker moves to a new higher-price, higher-quantity intersection.",
