  "metadata": {
    "title": "Supply, Demand, and Equilibrium",
    "subject": "Economics",
    "objective": "Show equilibrium where supply and demand intersect and how a demand shift moves it.",
    "learner": "Can read a simple x-y graph.",
    "misconceptions": [
      "A price change shifts the demand curve",
      "Equilibrium means everyone can buy at any price"
    ],
    "expectedUnderstanding": [
      "Demand slopes down and supply slopes up in this simple model.",
      "The intersection is the equilibrium price and quantity pair.",
      "A price change moves along a curve; a shifter moves the whole curve.",
      "Equilibrium is one price-quantity balance, not a promise that every buyer can buy at any price."
    ]
  },
  "properties": [
