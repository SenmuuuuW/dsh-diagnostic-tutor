  "metadata": {
    "title": "Pendulum Motion: Length and Release Angle",
    "subject": "Physics",
    "objective": "Show how length and initial release angle affect the period of a pendulum.",
    "learner": "Knows energy informally.",
    "misconceptions": [
      "Pendulum period depends strongly on mass",
      "The small-angle approximation is exact at all angles"
    ],
    "expectedUnderstanding": [
      "A longer pendulum has a longer period.",
      "Changing the release angle changes the amplitude and slightly changes the period.",
      "Mass is not a significant period driver in the ideal pendulum model.",
      "The small-angle formula is an approximation that becomes less accurate at large angles."
    ]
  },
