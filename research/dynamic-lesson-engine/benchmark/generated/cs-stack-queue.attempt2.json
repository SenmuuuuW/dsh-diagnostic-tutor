  "metadata": {
    "title": "Stack vs Queue: LIFO and FIFO",
    "subject": "Computer Science",
    "objective": "Contrast last-in, first-out and first-in, first-out with the same input sequence.",
    "learner": "Knows what a list is.",
    "misconceptions": [
      "A stack and a queue are the same structure",
      "The first item inserted is always removed first",
      "Removing an item changes where the other items sit"
    ],
    "expectedUnderstanding": [
      "A stack pushes and pops at the same end, so the newest item leaves first.",
      "A queue enqueues at the back and dequeues at the front, so the oldest item leaves first.",
      "The same input sequence 4, 7, 9 produces different removal orders in the two structures."
    ]
  },
