  "checkpoints": [
    {
      "id": "cp-sq-empty",
      "at": 0,
      "title": "One input, two structures",
      "body": "Both structures start empty. The input sequence is 4, then 7, then 9. A stack inserts and removes at the same end; a queue inserts at the back and removes at the front.",
      "pause": true
    },
    {
      "id": "cp-sq-first",
      "at": 1.2,
      "title": "Insert 4",
      "body": "4 is pushed onto the stack and enqueued into the queue. It is the bottom of the stack and the front of the queue, so it is already in the position each structure will remove from differently.",
      "pause": true
    },
    {
      "id": "cp-sq-second",
      "at": 2.8,
      "title": "Insert 7",
      "body": "7 sits above 4 on the stack, so the stack top is now 7. In the queue, 4 is still the front and 7 is behind it.",
      "pause": true
    },
    {
      "id": "cp-sq-third",
      "at": 4.4,
      "title": "Insert 9",
      "body": "The stack reads 4, 7, 9 from bottom to top, with 9 on top. The queue reads 4, 7, 9 from front to back, with 4 still first.",
      "pause": true
    },
    {
      "id": "cp-sq-remove",
      "at": 8.4,
      "title": "Remove once from each",
      "body": "Pop takes 9, because 9 was inserted last. Dequeue takes 4, because 4 was inserted first. The queue then shifts forward, but the stack keeps 4 at its bottom.",
      "pause": false
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "Both structures start empty. The input 4, then 7, then 9 will go into each one."
    },
    {
      "at": 1.2,
      "text": "4 is pushed onto the stack and enqueued at the back of the queue."
    },
    {
      "at": 2.8,
      "text": "7 is added. The stack top is now 7, but the queue front is still 4."
    },
    {
      "at": 4.4,
      "text": "9 is added. The stack holds 4, 7, 9 with 9 on top. The queue holds 4, 7, 9 with 4 at the front."
    },
    {
      "at": 7.8,
      "text": "Pop takes 9 from the stack. Dequeue takes 4 from the queue. The same input produced different removal orders."
    }
  ],
  "fallback": {
    "text": "A stack and a queue each receive 4, 7 and 9 in that order. The stack grows upward with 9 on top, so pop removes 9. The queue lines up with 4 at the front, so dequeue removes 4 and the remaining items shift forward."
  },
  "accessibility": {
    "alt": "A stack and a queue each receive 4, 7 and 9 in that order. The stack grows upward with 9 on top and 4 at the bottom; the queue runs left to right with 4 at the front. On removal the stack releases 9 while the queue releases 4, and the queue shifts forward.",
    "reducedMotion": "no-autoplay",
    "keyboard": true
  }
}
