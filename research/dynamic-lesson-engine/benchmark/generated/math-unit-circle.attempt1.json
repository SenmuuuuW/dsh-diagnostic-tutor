  "metadata": {
    "title": "Unit circle to sine wave: the height is the sine",
    "subject": "Mathematics / trigonometry",
    "objective": "Connect a point on the unit circle to the height of the sine curve.",
    "learner": "Knows right-triangle ratios; has not yet connected circular motion to sine.",
    "misconceptions": [
      "Sine is only a triangle ratio.",
      "The sine of an angle is the x-coordinate of the point on the circle."
    ],
    "expectedUnderstanding": [
      "The y-coordinate of a point on the unit circle is sin θ.",
      "Because the hypotenuse is 1, opposite ÷ hypotenuse and the height give the same number.",
      "The sine curve records that signed height as θ grows, crossing zero at 0 and π."
    ]
  },
  "properties": [
