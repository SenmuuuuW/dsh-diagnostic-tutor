  "checkpoints": [
    {
      "id": "cp-frame",
      "at": 0,
      "title": "One point, two views",
      "pause": false,
      "learnerAction": "continue",
      "body": "Left: a point on the circle of radius 1. Right: the height of that same point, plotted against the angle. Move the slider and keep an eye on both panels."
    },
    {
      "id": "cp-zero",
      "at": 3,
      "title": "Predict at θ = 0",
      "pause": true,
      "learnerAction": "answer",
      "body": "The point starts on the far right of the circle. Before you look, what is sin 0? Set the slider to 0 and check where the red bar, the dashed line and the dot on the curve all end up."
    },
    {
      "id": "cp-quarter",
      "at": 7.5,
      "title": "Predict at θ = π/2",
      "pause": true,
      "learnerAction": "answer",
      "body": "Set the slider to π/2 (nine 10° steps). How tall is the red bar now, and where does the point sit? The dot on the curve should reach the top guideline at 1, the largest height the circle allows."
    },
    {
      "id": "cp-which-coordinate",
      "at": 11.5,
      "title": "Which coordinate is the sine?",
      "pause": true,
      "learnerAction": "answer",
      "body": "At θ = 0 the point is at (1, 0): its x-coordinate is at its maximum while its sine is 0. Move to 0 and back towards π/2 — the blue x-offset shrinks while the red height grows. The sine is the height, never the x-coordinate."
    },
    {
      "id": "cp-negative",
      "at": 15.5,
      "title": "Where does the sine go negative?",
      "pause": true,
      "learnerAction": "answer",
      "body": "Turn past π. The point crosses below the centre, the red bar hangs downwards and the curve dips under the axis. Predict the height at 3π/2 before you drag there."
    },
    {
      "id": "cp-loop",
      "at": 19,
      "title": "Close the loop at 2π",
      "pause": false,
      "learnerAction": "continue",
      "body": "Set the slider to 2π: the point is back at (1, 0) and the curve is ready to repeat. One full turn of the circle is one full period of the wave."
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "The radius has length 1. Turn the point and its height changes; that height is sin θ."
    },
    {
      "at": 2.2,
      "text": "The red bar is the vertical side of the right triangle. With hypotenuse 1, opposite ÷ hypotenuse is just the height itself."
    },
    {
      "at": 4.6,
      "text": "The dashed line carries that height across to the curve. It is one number shown in two places."
    },
    {
      "at": 6.4,
      "text": "Use the arrow keys on the slider to step through the circle in 10° increments, or drag it smoothly."
    },
    {
      "at": 9.6,
      "text": "At θ = 0 and θ = π the height is zero, so the dot on the curve sits on the axis."
    },
    {
      "at": 12.2,
      "text": "At θ = π/2 the height is at its maximum, 1: the dot reaches the top guideline."
    },
    {
      "at": 14.6,
      "text": "Past π the point is below the centre, so the height is negative and the curve dips below the axis."
    },
    {
      "at": 17.2,
      "text": "At 2π the point returns to (1, 0) and the curve is ready to repeat: one turn, one period."
    }
  ],
  "fallback": {
    "text": "A unit circle of radius 1 on the left, with a point at angle θ. The red vertical bar from the point to the horizontal axis is the height of the point, which is sin θ; the blue dashed horizontal bar is cos θ. A dashed line carries that height to the right-hand graph of the sine curve, where a red dot sits at the same height: 0 at θ = 0 and θ = π, a maximum of 1 at θ = π/2, and a minimum of −1 at θ = 3π/2."
  },
  "accessibility": {
    "alt": "Unit circle with a point at angle θ set by a slider: a red vertical bar shows the height sin θ, a blue dashed bar shows cos θ. A dashed line carries the same height to a sine curve, where a red dot marks it; the curve is on the axis at 0 and π and peaks at π/2.",
    "reducedMotion": "no-autoplay",
    "keyboard": true
  }
}
