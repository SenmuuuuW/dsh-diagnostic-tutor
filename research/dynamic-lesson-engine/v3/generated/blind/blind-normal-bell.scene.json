  "checkpoints": [
    {
      "id": "cp-orient",
      "at": 1,
      "title": "A staircase of density",
      "body": "Each strip is a thin slice of the density, drawn as density times slice width. The tallest strips sit at the mean. Height is how dense the variable is there; it is not the probability of that exact value.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-mean",
      "at": 4,
      "title": "Drag the mean",
      "body": "Move the mean slider. The whole staircase and the red mean line slide sideways, but no strip changes shape or size. The mean is the centre, not a measure of spread.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-sigma",
      "at": 7.6,
      "title": "Drag the standard deviation",
      "body": "Move the sigma slider. Every strip gets wider by the same factor and every height divides by that factor, so the red one-sigma ticks spread apart while the peak drops. Predict first: does the total area grow?",
      "pause": true,
      "learnerAction": "answer"
    },
    {
      "id": "cp-area",
      "at": 10.5,
      "title": "Area is the invariant",
      "body": "The area is still 1. A wider normal is not a bigger normal; it trades height for width. A single value has zero width, so its area and its probability are both zero even though its density is not zero.",
      "pause": true,
      "learnerAction": "continue"
    }
  ],
  "narration": [
    {
      "at": 0.5,
      "text": "A normal density drawn as thin strips. Taller means denser, not more likely at a point."
    },
    {
      "at": 3.2,
      "text": "Slide the mean: the whole staircase translates and the red centre line goes with it."
    },
    {
      "at": 6.2,
      "text": "Slide the standard deviation: the strips widen and shorten together, and the one-sigma ticks move apart."
    },
    {
      "at": 9.2,
      "text": "Width up, height down, by the same factor. That is why the area, the actual probability, does not change."
    },
    {
      "at": 11.2,
      "text": "So the total area stays one. Density is a height; probability is an area under it."
    }
  ],
  "fallback": {
    "text": "A normal density is a bell-shaped curve whose total area is 1. Raising the mean slides the whole curve to the right without changing its shape. Raising the standard deviation makes the curve wider and lower by the same factor, so the area stays 1: the spread is not extra probability. At any single value x the density f(x) is a height, not a probability, because a point has no width and therefore zero area; probability only appears when you take the area under the curve over an interval."
  },
  "accessibility": {
    "alt": "A normal density as nine strips on an axis, tallest at the mean with a red mean line and red one-sigma ticks. Moving the mean slides it; increasing sigma widens and shortens it while total area stays one.",
    "reducedMotion": "static",
    "keyboard": true
  }
