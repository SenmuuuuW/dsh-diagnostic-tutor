  "metadata": {
    "title": "Normal Density: Mean Moves It, Sigma Stretches It",
    "subject": "Statistics",
    "objective": "Show how mean and standard deviation move a normal density without changing its total area.",
    "learner": "Knows mean and variation informally.",
    "misconceptions": [
      "The density at a point is the probability of that point",
      "A larger standard deviation means a larger total area"
    ],
    "expectedUnderstanding": [
      "The mean sets the horizontal centre of the density",
      "The standard deviation sets the spread, with width up and height down",
      "Total area under a normal density is 1 for every mean and standard deviation",
      "Height is density, area is probability"
    ]
  },
