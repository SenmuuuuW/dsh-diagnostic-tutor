  "checkpoints": [
    {
      "id": "cp-key",
      "at": 1,
      "title": "The key is the only link",
      "body": "Table A holds ids 1, 2 and 3. Table B holds ids 2, 3 and 4. Nothing else connects the tables, so a row from A can only meet a row from B when their id values are equal.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-trace",
      "at": 3.6,
      "title": "Trace id 2",
      "body": "Follow the arrow: A's id 2 points at B's id 2. The arrow slants, because the matching row is not at the same vertical position. Position is irrelevant; only the key value matters.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-count",
      "at": 7.2,
      "title": "Predict the row count",
      "body": "Before the result box fills: three rows times three rows gives nine possible pairs. How many pairs have equal ids? Only id 2 with id 2 and id 3 with id 3, so the answer is two rows, each combining columns from both tables.",
      "pause": true,
      "learnerAction": "answer"
    },
    {
      "id": "cp-dropped",
      "at": 10.6,
      "title": "Where the unmatched rows go",
      "body": "Ids 1 and 4 have no partner, so no pair exists for them and no output row is created. They fall out of the tables. A left join would keep them with empty right-hand columns, but an inner join does not.",
      "pause": false
    }
  ],
  "narration": [
    {
      "at": 0.6,
      "text": "Two tables. A holds ids one, two and three. B holds ids two, three and four. The shared key is id."
    },
    {
      "at": 3,
      "text": "A pair joins when the key values are equal, so id two meets id two, and id three meets id three."
    },
    {
      "at": 5.6,
      "text": "Each matching pair becomes one row that carries columns from both tables."
    },
    {
      "at": 8.2,
      "text": "Ids one and four have no partner, so they never enter the result. They drop out entirely."
    },
    {
      "at": 10.8,
      "text": "Two rows out, not six, and not nine. An inner join filters on the key; it does not stack the tables."
    }
  ],
  "fallback": {
    "text": "Table A has ids 1, 2 and 3. Table B has ids 2, 3 and 4. An inner join on id creates one output row for every pair of rows whose id values are equal: id 2 with id 2, and id 3 with id 3. Each output row contains the columns of both contributing rows. Rows whose id never appears on the other side, here 1 and 4, match nothing and therefore produce no output row at all. The result has two rows, not the six that stacking would give, and not the nine pairings that a cross join would give. Matching depends on key values, never on row position, and no ordering of the result is implied."
  },
