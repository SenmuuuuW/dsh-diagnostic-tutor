  "metadata": {
    "title": "SQL INNER JOIN: Only Matching Keys Produce a Row",
    "subject": "Computer Science",
    "topic": "SQL INNER JOIN",
    "objective": "Show why an inner join returns only matching key pairs and how unmatched rows disappear.",
    "learner": "Knows tables and rows.",
    "misconceptions": [
      "JOIN is just stacking the two tables",
      "INNER JOIN keeps all rows"
    ],
    "expectedUnderstanding": [
      "A pair of rows contributes to the result only when the join condition is true",
      "The output combines columns from both tables",
      "Rows without a partner on the other side are dropped",
      "Matching is by key value, not by row position"
    ]
  },
