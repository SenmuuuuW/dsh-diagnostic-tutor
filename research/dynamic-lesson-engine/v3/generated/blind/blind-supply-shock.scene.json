  "checkpoints": [
    {
      "id": "cp-initial",
      "at": 0.5,
      "title": "The initial market",
      "body": "Demand D slopes down and supply S slopes up. Where they cross, the market clears at price P1 and quantity Q1.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-shock",
      "at": 4.5,
      "title": "A supply shock",
      "body": "Higher input costs mean suppliers offer less at every price. The whole supply curve shifts left to S prime. That is a shift of supply, not a movement along supply.",
      "pause": false
    },
    {
      "id": "cp-new",
      "at": 9.5,
      "title": "The new equilibrium",
      "body": "The crossing is now up and to the left along the unchanged demand curve: price rises to P2 and quantity falls to Q2. At the old price P1 there is now a shortage, not a surplus, which pushes the price up.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-limits",
      "at": 13,
      "title": "What the model does and does not say",
      "body": "This is comparative statics: it predicts direction, not size or welfare. A demand shift moves price too, up or down depending on its direction, so do not read a supply shift as a demand shift.",
      "pause": false
    }
  ],
  "narration": [
    {
      "at": 0.5,
      "text": "Start with demand D and supply S. They cross at price P1 and quantity Q1."
    },
    {
      "at": 2.5,
      "text": "A supply shock means sellers offer less at every price, so the whole supply curve shifts left."
    },
    {
      "at": 6.5,
      "text": "Watch the crossing: it slides up along the demand curve, not along the supply curve."
    },
    {
      "at": 9.5,
      "text": "At the new crossing the price is higher, P2, and the quantity is lower, Q2."
    },
    {
      "at": 12,
      "text": "The grey curve is the old supply. Demand never moved, and the model predicts direction, not size."
    }
  ],
  "fallback": {
    "text": "Demand D and supply S first meet at price P1 and quantity Q1. A supply shock shifts the whole supply curve left to S prime: at every price, suppliers offer less. The new equilibrium lies up and to the left along the unchanged demand curve, so price is higher at P2 and quantity is lower at Q2. The grey S is the before state; the demand curve never moved. This comparative-statics model predicts direction only, not magnitude or welfare."
  },
