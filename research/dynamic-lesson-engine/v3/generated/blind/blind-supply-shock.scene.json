  "metadata": {
    "title": "A Supply Shock: Shift Versus Movement",
    "subject": "Economics",
    "objective": "Show that a leftward supply shift raises equilibrium price and lowers equilibrium quantity, and distinguish a curve shift from a movement along a curve.",
    "learner": "Knows supply and demand basics.",
    "misconceptions": [
      "A supply shock is a movement along the supply curve",
      "Price always rises when demand shifts"
    ],
    "expectedUnderstanding": [
      "A supply shock shifts the whole supply curve",
      "The new equilibrium lies along the unchanged demand curve",
      "Equilibrium price rises and equilibrium quantity falls",
      "The model predicts direction, not magnitude or welfare"
    ]
  },
