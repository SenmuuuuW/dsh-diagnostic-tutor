  "metadata": {
    "title": "Photosynthesis: Inputs, Stages and Outputs",
    "subject": "Biology",
    "objective": "Connect light, water and carbon dioxide inputs to glucose and oxygen outputs and distinguish the light-dependent reactions from the Calvin cycle.",
    "learner": "Knows cells and basic chemistry.",
    "misconceptions": [
      "Plants get most of their mass from soil",
      "Photosynthesis is the reverse of breathing in every detail",
      "Light is a material input like water and carbon dioxide"
    ],
    "expectedUnderstanding": [
      "Water and carbon dioxide are material inputs; light is energy",
      "The light-dependent reactions split water and release oxygen",
      "The Calvin cycle fixes carbon dioxide into glucose using ATP and NADPH",
      "Plants also respire, so the two processes are not simple reverses"
    ]
  },
