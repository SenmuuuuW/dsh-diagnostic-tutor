  "checkpoints": [
    {
      "id": "cp-inputs",
      "at": 0.5,
      "title": "Three arrivals",
      "body": "Light, water and carbon dioxide converge on the chloroplast. Light is an energy source; only water and carbon dioxide are material inputs.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-light-stage",
      "at": 5.5,
      "title": "Stage 1: light-dependent reactions",
      "body": "In the thylakoid membranes, light energy splits water. Oxygen leaves, and ATP and NADPH carry energy to the next stage.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-calvin",
      "at": 12.5,
      "title": "Stage 2: the Calvin cycle",
      "body": "In the stroma, the Calvin cycle uses ATP and NADPH to turn carbon dioxide into glucose. It does not absorb light directly, but if light stops, its ATP and NADPH supply soon runs out.",
      "pause": false
    },
    {
      "id": "cp-outputs",
      "at": 16,
      "title": "Outputs and the mass question",
      "body": "Oxygen and glucose leave. The carbon in glucose comes from carbon dioxide, not soil, and plants also respire, so photosynthesis is not breathing run backwards.",
      "pause": true,
      "learnerAction": "continue"
    }
  ],
  "narration": [
    {
      "at": 0.5,
      "text": "Light arrives first. It is energy, not a material input."
    },
    {
      "at": 3.5,
      "text": "Water enters the chloroplast and reaches the light-dependent reactions."
    },
    {
      "at": 6.5,
      "text": "Light energy splits water; oxygen leaves as a by-product."
    },
    {
      "at": 9.5,
      "text": "ATP and NADPH carry energy from the thylakoid stage to the Calvin cycle."
    },
    {
      "at": 12.5,
      "text": "Carbon dioxide is fixed into glucose in the stroma. No light is absorbed directly there."
    },
    {
      "at": 16,
      "text": "Most of the plant's dry mass is carbon from carbon dioxide, not soil, and plants also respire."
    }
  ],
  "fallback": {
    "text": "Light, water and carbon dioxide enter the chloroplast. Light is energy, not matter. In the thylakoid membranes the light-dependent reactions split water, release oxygen and pass ATP and NADPH to the Calvin cycle. In the stroma the Calvin cycle uses that energy to fix carbon dioxide into glucose. Oxygen and glucose leave the chloroplast. The carbon in glucose comes from carbon dioxide, not soil, and plants also respire, so photosynthesis is not respiration reversed."
  },
