  "metadata": {
    "title": "Recursion: Call Stack Descent and Unwind",
    "subject": "Computer Science",
    "objective": "Show the call stack growing and unwinding for a recursive function.",
    "learner": "Can read a simple function.",
    "misconceptions": ["Recursion runs all calls simultaneously", "The base case is executed first"],
    "expectedUnderstanding": [
      "Each recursive call pauses its caller and adds one unfinished frame.",
      "The base case is reached after the descent, then returns immediately.",
      "Return values unwind in reverse call order, from the newest frame to the oldest."
    ]
  },
