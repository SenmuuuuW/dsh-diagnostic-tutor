  "metadata": {
    "title": "Binary Search: Discarding Halves",
    "subject": "Computer Science",
    "objective": "Show the interval shrinking and why a sorted array is required.",
    "learner": "Can read array indices.",
    "misconceptions": ["Binary search works on any array", "The midpoint is always the answer"],
    "expectedUnderstanding": [
      "A sorted order makes it safe to discard an entire half after one comparison.",
      "The low and high bounds always bracket the target when it is present.",
      "The loop ends on a match, or when low passes high and the target is absent."
    ]
  },
