  "checkpoints": [
    {"id": "cp0", "at": 1, "title": "Sorted order is the premise", "body": "The values increase left to right. That is why 23 > 9 lets us discard every cell left of and including index 2: no excluded value can be 23.", "pause": true, "learnerAction": "continue"},
    {"id": "cp1", "at": 5, "title": "First half is out", "body": "Indices 0, 1 and 2 fade. The interval is now low=3 to high=4, and index 3 is the new midpoint. The target remains inside the remaining interval.", "pause": true, "learnerAction": "continue"},
    {"id": "cp2", "at": 9, "title": "Midpoint is not the answer", "body": "The first midpoint held 9 and the second held 14, but the target is 23. The midpoint is only the comparison point; it becomes the answer only when its value equals the target.", "pause": true, "learnerAction": "continue"},
    {"id": "cp3", "at": 13, "title": "Termination", "body": "Now low=high=4 and cell 4 holds 23. Return index 4. If low ever passes high, the interval is empty and the target is absent.", "pause": true, "learnerAction": "continue"}
  ],
  "narration": [
    {"at": 0, "text": "Binary search needs a sorted array and a target."},
    {"at": 4, "text": "Compare the target with the midpoint, then discard the half that cannot contain it."},
    {"at": 8, "text": "The bounds close in; the midpoint is not automatically the answer."},
    {"at": 12, "text": "When the midpoint matches, return its index."}
  ],
