    {"id": "cp0", "at": 1, "title": "BFS keeps a queue", "body": "Start at A. Its neighbors B and C enter the queue. The larger circles are the frontier, the nodes discovered but not yet visited; the visited set contains only A.", "pause": true, "learnerAction": "continue"},
    {"id": "cp1", "at": 11, "title": "BFS distances", "body": "BFS visits A, B, C, D, E. At unweighted distances: A=0, B=1, C=1, D=2, E=3. The queue order is why D and E wait behind C.", "pause": true, "learnerAction": "continue"},
    {"id": "cp2", "at": 16.5, "title": "DFS switches to a stack", "body": "Restart at A with DFS. A pushes B and C, then follows B to D and E before C. The status names the stack and its top. DFS order is A, B, D, E, C, so the path to E is longer than BFS's distance-3 route.", "pause": true, "learnerAction": "continue"},
    {"id": "cp3", "at": 25.5, "title": "Visited prevents repeats", "body": "At C, the edge to D is skipped because D is already visited. Every node is processed once. BFS order A,B,C,D,E differs from DFS order A,B,D,E,C; only BFS guarantees the shortest unweighted distances shown.", "pause": true, "learnerAction": "continue"}
  ],
  "narration": [
    {"at": 0, "text": "BFS starts at A and keeps discovered nodes in a queue."},
    {"at": 8, "text": "The queue visits B and C before D and E, giving shortest unweighted distances."},
    {"at": 13, "text": "Now restart with DFS, which keeps its frontier in a stack."},
    {"at": 23, "text": "DFS reaches E before C and skips already visited D; the orders differ."}
