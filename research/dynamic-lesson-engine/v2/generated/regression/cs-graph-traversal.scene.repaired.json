    "title": "Graph Traversal: BFS and DFS",
    "subject": "Computer Science",
    "objective": "Show BFS/DFS visiting order and frontier differences.",
    "learner": "Knows nodes and edges.",
    "misconceptions": ["DFS always finds the shortest path in an unweighted graph", "Visited nodes can be revisited forever"],
    "expectedUnderstanding": [
      "BFS uses a queue, so it visits nodes in nondecreasing distance from the start.",
      "DFS uses a stack, so it follows one branch deeply before returning to other neighbors.",
      "A visited set prevents a node from being processed or revisited again."
    ]
  },
