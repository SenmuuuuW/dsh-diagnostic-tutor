    "objective": "Contrast LIFO and FIFO operations with the same sequence.",
    "learner": "Knows a list.",
    "misconceptions": ["Stacks and queues are the same structure", "The first inserted item is always removed first"],
    "expectedUnderstanding": [
      "A stack pushes and pops at the same end, so the newest item leaves first.",
      "A queue enqueues at the rear and dequeues at the front, so the oldest item leaves first.",
      "The same input order produces opposite removal orders."
    ]
  },
