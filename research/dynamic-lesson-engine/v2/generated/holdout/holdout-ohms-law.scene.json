{
  "version": "0.1",
  "viewport": {
    "width": 720,
    "height": 560,
    "background": "#ffffff"
  },
  "metadata": {
    "title": "Ohm's Law in a Series Circuit",
    "subject": "Physics",
    "objective": "Show the relationship among voltage, resistance and current in a simple series circuit.",
    "learner": "Knows basic multiplication.",
    "misconceptions": [
      "Current is used up by a resistor",
      "Voltage and current are the same quantity"
    ],
    "expectedUnderstanding": [
      "Current is voltage divided by resistance",
      "At fixed resistance, current is proportional to voltage",
      "At fixed voltage, current is inversely proportional to resistance"
    ]
  },
  "properties": [
    {
      "id": "voltage",
      "label": "Voltage",
      "min": 1,
      "max": 12,
      "step": 0.5,
      "default": 6,
      "unit": "V"
    },
    {
      "id": "resistance",
      "label": "Resistance",
      "min": 1,
      "max": 10,
      "step": 0.5,
      "default": 3,
      "unit": "ohm"
    }
  ],
  "primitives": [
