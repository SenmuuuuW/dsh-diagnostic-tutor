  "metadata": {
    "title": "Hypothesis Test: Null Distribution, p-Tail and Alpha",
    "subject": "Statistics",
    "objective": "Show a null distribution, an observed statistic and a p-value tail without conflating it with the probability the null is true.",
    "learner": "Knows sampling distributions.",
    "misconceptions": [
      "p is the probability the null is true",
      "A small p proves the alternative"
    ],
    "expectedUnderstanding": [
      "The null distribution describes outcomes if the null model holds",
      "p is the tail area at least as extreme as the observed statistic",
      "Alpha is a decision threshold chosen in advance",
      "A small p is evidence against the null, not proof of the alternative"
    ]
  },
