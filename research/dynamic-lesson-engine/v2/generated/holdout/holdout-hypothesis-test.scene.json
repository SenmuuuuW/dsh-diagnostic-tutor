    {
      "id": "alphaControl",
      "kind": "slider",
      "propertyId": "alpha",
      "label": "Change the alpha decision level"
    }
  ],
  "checkpoints": [
    {
      "id": "cp-null",
      "at": 1,
      "title": "Null first",
      "body": "The bars are the null distribution of z: centered at 0 with thin tails. The red line is the observed statistic, movable with the slider. The observed statistic is not the p-value.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-tail",
      "at": 3.5,
      "title": "The tail is p",
      "body": "The shaded bars to the right of the observed z are outcomes at least as extreme. Move z right and less area is shaded, so p is smaller. Move z left and more area is shaded, so p is larger.",
      "pause": true,
      "learnerAction": "answer"
    },
    {
      "id": "cp-alpha",
      "at": 6,
      "title": "Alpha is a rule, not a posterior",
      "body": "The dashed line is alpha, a decision threshold chosen before seeing the data. It is not the probability the null is true, and neither is p. A small p is evidence against the null, not proof of the alternative.",
      "pause": true,
      "learnerAction": "answer"
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "The bars show the null distribution of z; the red line is the observed statistic."
    },
    {
      "at": 3,
      "text": "The shaded right tail is the p-value: outcomes at least as extreme as the observation."
    },
    {
      "at": 6,
      "text": "Alpha is a separate decision line, not the probability that the null is true."
    }
  ],
  "fallback": {
    "text": "A null distribution of z is shown with nine bars centered at 0 and thin tails. The observed statistic is a red vertical line controlled by the z slider, and the bars to its right are shaded: that right-tail area represents p. Moving the observed statistic changes the shaded area, so p depends on the data, not on alpha. The dashed alpha line is a decision threshold chosen in advance; changing alpha moves that line but does not change the observed statistic or the p-value. Neither p nor alpha is the probability that the null hypothesis is true. A small p is evidence against the null model, not proof that the alternative is true, and the scene makes no causal claim."
  },
  "accessibility": {
    "alt": "Nine bars form a null z distribution. A red line marks observed z; bars to its right are shaded as the p tail. A dashed alpha line moves with the alpha slider but does not change the observed statistic or tail.",
    "reducedMotion": "static",
    "keyboard": true
  }
}
