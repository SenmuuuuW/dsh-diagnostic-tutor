  "checkpoints": [
    {
      "id": "cp-start",
      "at": 1,
      "title": "Initialize the frontier",
      "body": "A starts at distance 0. B is reachable directly at 4 and C at 1, so both are in the frontier: discovered but not finalized. D is not yet discovered.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-c",
      "at": 3.5,
      "title": "Finalize C at 1",
      "body": "C has the smallest tentative distance, 1, so it is finalized. Relaxing C-B gives 1+2=3, which is smaller than B's 4, so B's tentative distance updates to 3.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-b",
      "at": 6,
      "title": "Finalize B at 3",
      "body": "B is finalized at 3. Relaxing B-D gives 3+1=4, smaller than D's 6. The first route found, A-B-D at 5, is not the shortest; the later update wins.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-d",
      "at": 8.5,
      "title": "Finalize D at 4",
      "body": "D is finalized at 4. The shortest path is A-C-B-D, costing 1+2+1=4. All weights are nonnegative; with a negative edge, finalizing the smallest tentative distance would not be safe.",
      "pause": true,
      "learnerAction": "answer"
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "Start at A. B and C enter the frontier with tentative distances 4 and 1."
    },
    {
      "at": 3,
      "text": "Finalize C at 1, then relax C to B: B improves from 4 to 3."
    },
    {
      "at": 6,
      "text": "Finalize B at 3, then relax B to D: D improves from 6 to 4."
    },
    {
      "at": 9,
      "text": "The shortest path is A-C-B-D. The first path found was not the shortest."
    }
  ],
