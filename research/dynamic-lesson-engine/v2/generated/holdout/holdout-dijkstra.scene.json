    "title": "Dijkstra: Finalizing the Shortest Tentative Distance",
    "subject": "Computer Science",
    "objective": "Show the frontier and tentative distances as a shortest-path search proceeds.",
    "learner": "Knows graphs and nonnegative weights.",
    "misconceptions": [
      "Dijkstra works with negative weights",
      "The first path found is always shortest"
    ],
    "expectedUnderstanding": [
      "The frontier contains discovered but unfinalized nodes",
      "A node is finalized at its smallest tentative distance",
      "Relaxation replaces a distance only when the new route is smaller",
      "Negative weights break the greedy finalization step"
    ]
  },
