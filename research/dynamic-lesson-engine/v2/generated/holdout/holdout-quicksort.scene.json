  "metadata": {
    "title": "Quicksort: One Partition Step",
    "subject": "Computer Science",
    "objective": "Show a partition step around a pivot and the resulting left and right parts.",
    "learner": "Can read array indices.",
    "misconceptions": [
      "Quicksort always divides the array in half",
      "Partitioning sorts the whole array immediately"
    ],
    "expectedUnderstanding": [
      "Elements left of the pivot are at most the pivot and elements right are at least the pivot",
      "The pivot reaches its final sorted index",
      "The recursive parts exclude the pivot and may be very unequal"
    ]
  },
