  "controls": [],
  "checkpoints": [
    {
      "id": "cp-pivot",
      "at": 1,
      "title": "Pivot chosen",
      "body": "The pivot is the value 5. Everything smaller than 5 will go to its left; everything larger will go to its right.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-scan",
      "at": 3,
      "title": "Scan the other values",
      "body": "Compare each value with 5. The values 3, 1 and 2 are smaller, so they belong on the left. The value 8 is larger, so it belongs on the right.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-partition",
      "at": 5,
      "title": "Partition complete",
      "body": "The array is now [3, 1, 2, 5, 8]. The pivot 5 is at its final sorted index. The left part is [3, 1, 2] and the right part is [8].",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-recurse",
      "at": 7,
      "title": "Recurse on the parts",
      "body": "Quicksort now sorts [3, 1, 2] and [8] separately. The pivot 5 is excluded from both recursive calls. This split is 3 | 1, not half.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-not-sorted",
      "at": 9,
      "title": "Partition is not a full sort",
      "body": "The pivot is fixed, but [3, 1, 2] is still unsorted. Partitioning alone does not finish the array; the recursive calls must do the rest.",
      "pause": true,
      "learnerAction": "continue"
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "Start with the array 5, 3, 8, 1, 2 and choose 5 as the pivot."
    },
    {
      "at": 4,
      "text": "Move smaller values to the left and larger values to the right of the pivot."
    },
    {
      "at": 8,
      "text": "The pivot is in place. Recurse on the left part and the right part, excluding the pivot."
    }
  ],
