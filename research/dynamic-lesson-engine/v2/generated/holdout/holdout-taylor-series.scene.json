  "metadata": {
    "title": "Taylor Series: A Local Fit",
    "subject": "Mathematics",
    "objective": "Show why a truncated Taylor polynomial matches a function near a point and diverges away from it.",
    "learner": "Knows derivatives and polynomial graphs.",
    "misconceptions": [
      "More terms always help everywhere",
      "The Taylor polynomial equals the function globally"
    ],
    "expectedUnderstanding": [
      "Taylor polynomials match the function and its derivatives at the center",
      "Adding terms widens the interval of good agreement",
      "A Taylor polynomial is generally not equal to the function everywhere"
    ]
  },
