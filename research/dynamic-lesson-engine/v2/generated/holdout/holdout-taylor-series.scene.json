  "controls": [
    {
      "id": "orderControl",
      "kind": "slider",
      "propertyId": "order",
      "label": "Number of Taylor terms"
    }
  ],
  "checkpoints": [
    {
      "id": "cp-center",
      "at": 1,
      "title": "At the center",
      "body": "At x = 0, cos(0) = 1 and every Taylor polynomial also equals 1. The curves overlap at the center.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-away",
      "at": 4,
      "title": "Away from the center",
      "body": "Move away from x = 0: P2 separates first, then P4, then P6. A higher-order polynomial stays close over a wider interval.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-local",
      "at": 7,
      "title": "More terms are still local",
      "body": "Even P6 departs near the edges. More terms improve the local fit but do not make the polynomial equal to cos x globally.",
      "pause": true,
      "learnerAction": "continue"
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "The thick curve is cos x; the others are Taylor polynomials centered at 0."
    },
    {
      "at": 3,
      "text": "Near the center the approximations overlap."
    },
    {
      "at": 6,
      "text": "Away from the center they separate; the fit is local."
    }
  ],
  "fallback": {
    "text": "A cosine curve is compared with Taylor polynomials P2, P4 and P6 around x = 0. Near the center the curves nearly overlap; away from the center they separate, and adding terms only extends the useful interval. The polynomial never equals the function globally."
  },
  "accessibility": {
    "alt": "Graph of cos x and Taylor polynomials P2, P4, P6 around x=0. Curves overlap near the center and separate toward the edges; a slider changes how many terms are shown.",
    "reducedMotion": "no-autoplay",
    "keyboard": true
  }
