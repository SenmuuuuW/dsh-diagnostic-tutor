{
  "version": "0.1",
  "viewport": {
    "width": 720,
    "height": 560,
    "background": "#ffffff"
  },
  "metadata": {
    "title": "Bayes Rule: Screening and Base Rates",
    "subject": "Mathematics",
    "objective": "Show how a prior and a likelihood produce a posterior in a simple screening example.",
    "learner": "Knows ratios and percentages.",
    "misconceptions": [
      "A positive test means the disease is very likely",
      "Base rate does not matter"
    ],
    "expectedUnderstanding": [
      "The posterior is the true-positive share of all positive tests",
      "Low prevalence can make false positives dominate",
      "Sensitivity and posterior probability are different rates"
    ]
  },
  "properties": [
    {
      "id": "prevalence",
      "label": "Prevalence (0.05 = 5%)",
      "min": 0.01,
      "max": 0.2,
      "step": 0.01,
      "default": 0.05
    },
    {
      "id": "sensitivity",
      "label": "Test sensitivity (0.9 = 90%)",
      "min": 0.5,
      "max": 1,
      "step": 0.05,
      "default": 0.9
    }
  ],
  "primitives": [
    {
      "id": "title",
      "type": "text",
      "x": 40,
      "y": 42,
      "text": "Bayes rule: a positive test is not the same as disease",
      "fontSize": 22,
      "fill": "#111827"
    },
    {
      "id": "populationLabel",
      "type": "text",
      "x": 40,
      "y": 112,
      "text": "1,000 people",
      "fontSize": 15,
      "fill": "#374151"
    },
    {
      "id": "totalBar",
      "type": "rect",
      "x": 210,
      "y": 96,
      "width": 450,
      "height": 26,
      "fill": "#e5e7eb",
      "stroke": "#9ca3af",
      "strokeWidth": 1
    },
    {
      "id": "diseasedBar",
      "type": "rect",
      "x": 210,
      "y": 96,
      "width": {
        "expr": "450 * prevalence"
      },
      "height": 26,
      "fill": "#2563eb"
    },
    {
      "id": "positiveLabel",
      "type": "text",
      "x": 40,
      "y": 198,
      "text": "Positive tests",
      "fontSize": 15,
      "fill": "#374151"
    },
    {
      "id": "truePositiveBar",
      "type": "rect",
      "x": 210,
      "y": 182,
      "width": {
        "expr": "450 * prevalence * sensitivity / (prevalence * sensitivity + (1 - prevalence) * 0.1)"
      },
      "height": 26,
      "fill": "#1d4ed8"
    },
    {
      "id": "falsePositiveBar",
      "type": "rect",
      "x": {
        "expr": "210 + 450 * prevalence * sensitivity / (prevalence * sensitivity + (1 - prevalence) * 0.1)"
      },
      "y": 182,
      "width": {
        "expr": "450 * (1 - prevalence) * 0.1 / (prevalence * sensitivity + (1 - prevalence) * 0.1)"
      },
      "height": 26,
      "fill": "#f59e0b"
    },
    {
      "id": "posteriorLabel",
      "type": "text",
      "x": 40,
      "y": 300,
      "text": "P(disease | positive)",
      "fontSize": 15,
      "fill": "#374151"
    },
    {
      "id": "posteriorBg",
      "type": "rect",
      "x": 210,
      "y": 280,
      "width": 450,
      "height": 30,
      "fill": "#f3f4f6",
      "stroke": "#9ca3af",
      "strokeWidth": 1
    },
    {
      "id": "posteriorFill",
      "type": "rect",
      "x": 210,
      "y": 280,
      "width": {
        "expr": "450 * prevalence * sensitivity / (prevalence * sensitivity + (1 - prevalence) * 0.1)"
      },
      "height": 30,
      "fill": "#0f766e"
    },
    {
      "id": "halfMarker",
      "type": "line",
      "x1": 435,
      "y1": 270,
      "x2": 435,
      "y2": 320,
      "stroke": "#111827",
      "strokeWidth": 2
    },
    {
      "id": "halfLabel",
      "type": "text",
      "x": 420,
      "y": 338,
      "text": "50%",
      "fontSize": 13,
      "fill": "#111827"
    },
    {
      "id": "formula",
      "type": "text",
      "x": 40,
      "y": 402,
      "text": "posterior = TP / (TP + FP)",
      "fontSize": 16,
      "fill": "#111827"
    },
    {
      "id": "causeNote",
      "type": "text",
      "x": 40,
      "y": 436,
      "text": "Top bar: diseased share. Positive bar: TP left, FP right.",
      "fontSize": 14,
      "fill": "#374151"
    },
    {
      "id": "specificityNote",
      "type": "text",
      "x": 40,
      "y": 468,
      "text": "Specificity is fixed at 90%; sensitivity is adjustable.",
      "fontSize": 14,
      "fill": "#374151"
    },
    {
      "id": "baseRateNote",
      "type": "text",
      "x": 40,
      "y": 500,
      "text": "At low prevalence, false positives can dominate true positives.",
      "fontSize": 14,
      "fill": "#b91c1c"
    }
  ],
  "timeline": {
    "duration": 8,
    "tracks": [
      {
        "target": {
          "primitive": "halfMarker",
          "property": "opacity"
        },
        "keyframes": [
          {
            "at": 0,
            "value": 0.45,
            "easing": "ease-in-out"
          },
          {
            "at": 4,
            "value": 1,
            "easing": "ease-in-out"
          },
          {
            "at": 8,
            "value": 0.45,
            "easing": "ease-in-out"
          }
        ]
      }
    ]
  },
  "controls": [
    {
      "id": "prevalenceControl",
      "kind": "slider",
      "propertyId": "prevalence",
      "label": "How common is the disease? (0.05 = 5%)"
    },
    {
      "id": "sensitivityControl",
      "kind": "slider",
      "propertyId": "sensitivity",
      "label": "How sensitive is the test? (0.9 = 90%)"
    }
  ],
  "checkpoints": [
    {
      "id": "cp-counts",
      "at": 1,
      "title": "Count the positives",
      "body": "At 5% prevalence and 90% sensitivity, about 45 of 1,000 people are true positives and about 95 are false positives. The true-positive share is 45/140, about 32%.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-base-rate",
      "at": 3,
      "title": "Base rate matters",
      "body": "Lower the prevalence without changing sensitivity. The true-positive bar shrinks while the false-positive bar grows, so the posterior falls.",
      "pause": true,
      "learnerAction": "continue"
    },
    {
      "id": "cp-posterior",
      "at": 5,
      "title": "Posterior is not sensitivity",
      "body": "The posterior bar is TP/(TP+FP), the share of positive tests that are correct. It is not the same as the 90% sensitivity of the test.",
      "pause": true,
      "learnerAction": "continue"
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "Start with 1,000 people and a 5% prevalence."
    },
    {
      "at": 3,
      "text": "The positive-test bar is divided into true positives and false positives."
    },
    {
      "at": 6,
      "text": "The posterior is the true-positive share of all positive tests."
    }
  ],
  "fallback": {
    "text": "A population bar shows 1,000 people, with the diseased share set by prevalence. The positive-test bar splits into true positives and false positives. The posterior bar shows TP/(TP+FP): at low prevalence, false positives can be a large share, so a positive test does not imply a high probability of disease."
  },
  "accessibility": {
    "alt": "Population bar for 1,000 people, positive-test bar split into true and false positives, and posterior bar with a 50% marker. Sliders change prevalence and sensitivity.",
    "reducedMotion": "no-autoplay",
    "keyboard": true
  }
}
