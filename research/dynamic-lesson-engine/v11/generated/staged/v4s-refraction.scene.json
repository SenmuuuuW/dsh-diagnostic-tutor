{
  "version": "0.1",
  "viewport": {
    "width": 960,
    "height": 540,
    "background": "#ffffff"
  },
  "metadata": {
    "title": "Bending at the Boundary: Snell's Law",
    "subject": "Physics",
    "topic": "Snell's Law",
    "objective": "Show how a ray bends when entering a denser medium and why the normal is a reference.",
    "learner": "Knows angles and waves.",
    "misconceptions": [
      "Light bends toward the normal at every boundary, regardless of the media.",
      "The angle of incidence is measured from the surface rather than from the normal."
    ],
    "expectedUnderstanding": [
      "Angles of incidence and refraction are both measured from the normal, not the surface.",
      "When the second medium has a higher refractive index, the ray bends toward the normal.",
      "Snell's law relates the two angles through the refractive indices: n1 sin(theta1) = n2 sin(theta2)."
    ]
  },
  "properties": [
    {
      "id": "incidenceAngle",
      "label": "Incidence angle (from normal)",
      "min": 0,
      "max": 1.4,
      "step": 0.01,
      "default": 0.7,
      "unit": "rad"
    },
    {
      "id": "n2",
      "label": "Refractive index of second medium",
      "min": 1,
      "max": 2.5,
      "step": 0.01,
      "default": 1.5
    }
  ],
  "primitives": [
    {
      "id": "boundary",
      "type": "line",
      "x1": 80,
      "y1": 300,
      "x2": 880,
      "y2": 300,
      "fill": "none",
      "stroke": "#64748b",
      "strokeWidth": 3
    },
    {
      "id": "normal",
      "type": "line",
      "x1": 480,
      "y1": 80,
      "x2": 480,
      "y2": 480,
      "fill": "none",
      "stroke": "#94a3b8",
      "strokeWidth": 1.5,
      "dash": "7 7"
    },
    {
      "id": "incident-ray",
      "type": "arrow",
      "x1": {
        "expr": "480 - 230*Math.sin(incidenceAngle)"
      },
      "y1": {
        "expr": "300 - 230*Math.cos(incidenceAngle)"
      },
      "x2": 480,
      "y2": 300,
      "fill": "none",
      "stroke": "#f59e0b",
      "strokeWidth": 3
    },
    {
      "id": "refracted-ray",
      "type": "arrow",
      "x1": 480,
      "y1": 300,
      "x2": {
        "expr": "480 + 190*Math.sin(Math.asin(Math.sin(incidenceAngle)/n2))"
      },
      "y2": {
        "expr": "300 + 190*Math.cos(Math.asin(Math.sin(incidenceAngle)/n2))"
      },
      "fill": "none",
      "stroke": "#0ea5e9",
      "strokeWidth": 3
    },
    {
      "id": "entry-point",
      "type": "circle",
      "cx": 480,
      "cy": 300,
      "r": 5,
      "fill": "#0f172a",
      "stroke": "#0f172a",
      "strokeWidth": 1
    },
    {
      "id": "title",
      "type": "text",
      "x": 32,
      "y": 42,
      "fontSize": 21,
      "fill": "#0f172a",
      "stroke": "none",
      "text": "Snell's law: measure both angles from the normal",
      "anchor": "start",
      "fontWeight": 600
    },
    {
      "id": "medium-one-label",
      "type": "text",
      "x": 80,
      "y": 100,
      "fontSize": 14,
      "fill": "#475569",
      "stroke": "none",
      "text": "Medium 1 · n₁ = 1.00",
      "anchor": "start"
    },
    {
      "id": "medium-two-label",
      "type": "text",
      "x": 80,
      "y": 456,
      "fontSize": 14,
      "fill": "#475569",
      "stroke": "none",
      "text": "Medium 2 · n₂ adjustable",
      "anchor": "start"
    },
    {
      "id": "normal-label",
      "type": "text",
      "x": 494,
      "y": 96,
      "fontSize": 13,
      "fill": "#64748b",
      "stroke": "none",
      "text": "normal",
      "anchor": "start"
    },
    {
      "id": "theta-one-label",
      "type": "text",
      "x": {
        "expr": "480 - 76*Math.sin(incidenceAngle/2)"
      },
      "y": {
        "expr": "300 - 76*Math.cos(incidenceAngle/2)"
      },
      "fontSize": 17,
      "fill": "#b45309",
      "stroke": "none",
      "text": "θ₁",
      "anchor": "middle",
      "fontWeight": 600
    },
    {
      "id": "theta-two-label",
      "type": "text",
      "x": {
        "expr": "480 + 78*Math.sin(Math.asin(Math.sin(incidenceAngle)/n2)/2)"
      },
      "y": {
        "expr": "300 + 78*Math.cos(Math.asin(Math.sin(incidenceAngle)/n2)/2)"
      },
      "fontSize": 17,
      "fill": "#0369a1",
      "stroke": "none",
      "text": "θ₂",
      "anchor": "middle",
      "fontWeight": 600
    },
    {
      "id": "caption",
      "type": "text",
      "x": 32,
      "y": 520,
      "fontSize": 14,
      "fill": "#475569",
      "stroke": "none",
      "text": "The dashed normal is the reference: with n₂ > 1, the refracted ray bends toward it.",
      "anchor": "start"
    }
  ],
