  "controls": [
    {
      "id": "incidence-control",
      "kind": "slider",
      "propertyId": "incidenceAngle",
      "label": "Incidence angle (from normal)"
    },
    {
      "id": "n2-control",
      "kind": "slider",
      "propertyId": "n2",
      "label": "Second refractive index"
    }
  ],
  "checkpoints": [
    {
      "id": "cp-bend",
      "at": 3,
      "title": "Predict the bend",
      "body": "Hold the incidence angle fixed and increase n₂. Will the refracted ray move toward the normal, away from it, or stay put?",
      "pause": true,
      "learnerAction": "answer"
    },
    {
      "id": "cp-reference",
      "at": 5.6,
      "title": "Check the reference",
      "body": "A ray makes a 30° angle with the boundary. Is its angle of incidence 30°? Explain which reference line to use.",
      "pause": true,
      "learnerAction": "answer"
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "The dashed normal is perpendicular to the surface at the entry point."
    },
    {
      "at": 1.7,
      "text": "Both angles are measured from this normal, not from the surface."
    },
    {
      "at": 3.8,
      "text": "A larger n₂ means a denser second medium, so the same incidence angle produces a smaller refraction angle."
    },
    {
      "at": 5.2,
      "text": "Equal indices would leave the ray straight; here the bend is toward the normal."
    },
    {
      "at": 6.4,
      "text": "A 30° angle to the surface corresponds to 60° measured from the normal."
    }
  ],
  "fallback": {
    "text": "Draw a normal line perpendicular to the surface at the point where the ray enters. Measure both the incident angle and the refracted angle from that normal. For light going from a less dense medium into a denser one, the second index is larger, so the refracted ray bends toward the normal. If the indices are equal, the ray continues straight. Snell's law, n1 sin(theta1) = n2 sin(theta2), gives the exact relationship; the normal is the reference that makes the comparison meaningful."
  },
  "accessibility": {
    "alt": "A ray strikes a horizontal boundary between air and a denser medium, with a dashed normal perpendicular to the surface; incident and refracted rays lie on opposite sides of the normal, and the refracted ray bends closer to it as the index increases.",
    "reducedMotion": "static",
    "keyboard": true
  }
}
