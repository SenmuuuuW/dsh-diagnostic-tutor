  "narration": [
    {
      "at": 0,
      "text": "Two sorted halves are ready: 27 and 38 on the left, 9 and 82 on the right."
    },
    {
      "at": 1.5,
      "text": "At each merge step, compare the two front elements and take the smaller one."
    },
    {
      "at": 3,
      "text": "Step 1 places 9 first; the next comparisons place 27, then 38, then 82."
    },
    {
      "at": 5,
      "text": "The merge is linear because each element is examined once, but it needs extra memory for the output."
    },
    {
      "at": 6.4,
      "text": "Splitting only divides the array; sorting happens in the halves before this merge begins."
    }
  ],
  "fallback": {
    "text": "Merge sort divides the array into halves, divides those halves again, and continues until each piece has one element. A one-element piece is already sorted, so the algorithm then merges pairs of sorted pieces. During a merge, it compares the two front elements, takes the smaller one, and repeats until both pieces are exhausted. The result is sorted because each input piece was sorted first. Standard merge sort is not in place: it needs extra memory for the merged output, typically O(n)."
  },
  "accessibility": {
    "alt": "An array is split into smaller subarrays, then sorted pairs are merged by repeatedly taking the smaller front element; a step counter highlights the current split or merge without claiming the process is in place.",
    "reducedMotion": "static",
    "keyboard": true
  }
