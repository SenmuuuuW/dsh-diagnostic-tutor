      "learnerAction": "answer"
    },
    {
      "id": "cp-sorted-halves",
      "at": 5.2,
      "title": "Why sorted halves?",
      "body": "Why must each half already be sorted before this merge can produce a fully sorted result?",
      "pause": true,
      "learnerAction": "answer"
    }
