  "metadata": {
    "title": "From Score to Probability: Logistic Regression",
    "subject": "AI/ML",
    "topic": "Logistic Regression",
    "objective": "Show a decision boundary and how predicted probability changes with a feature.",
    "learner": "Knows linear functions and probability.",
    "misconceptions": [
      "Logistic regression outputs a hard class directly from a straight line.",
      "A predicted probability can exceed 1 when the linear score is large."
    ],
    "expectedUnderstanding": [
      "A linear score z = w*x + b is passed through the sigmoid to produce a probability.",
      "The sigmoid output is always between 0 and 1, approaching but never reaching the endpoints.",
      "The decision boundary is where the score is 0 and the predicted probability is 0.5.",
      "Changing a weight changes predicted odds; it is not by itself evidence of a causal effect."
    ]
  },
