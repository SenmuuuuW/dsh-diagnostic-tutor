  "metadata": {
    "title": "Tangent Meets Radius: A Right Angle on the Unit Circle",
    "subject": "Mathematics",
    "topic": "Unit Circle and Tangency",
    "objective": "Show why the tangent at a point on a unit circle is perpendicular to the radius.",
    "learner": "Knows circle geometry and basic sine/cosine.",
    "misconceptions": [
      "A tangent is the same thing as a radius.",
      "The right angle between the tangent and the radius is accidental rather than forced by the circle's geometry."
    ],
    "expectedUnderstanding": [
      "The tangent touches the circle at exactly one point: the chosen point.",
      "The tangent direction is perpendicular to the radius at that point for every angle.",
      "Rotating the point moves both the radius and the tangent while preserving the right angle."
    ]
  },
  "properties": [
    {
      "id": "angle",
      "label": "Point angle",
      "min": 0,
      "max": 6.283,
      "step": 0.01,
      "default": 0.8,
      "unit": "rad"
    }
  ],
  "primitives": [
    {
      "id": "unit-circle",
      "type": "circle",
      "cx": 480,
      "cy": 270,
      "r": 160,
      "fill": "none",
      "stroke": "#1d4ed8",
      "strokeWidth": 3
    },
    {
      "id": "center",
      "type": "circle",
      "cx": 480,
      "cy": 270,
      "r": 4,
      "fill": "#0f172a",
      "stroke": "#0f172a",
      "strokeWidth": 1
    },
    {
      "id": "point",
      "type": "circle",
      "cx": {
        "expr": "480 + 160*Math.cos(angle)"
      },
      "cy": {
        "expr": "270 - 160*Math.sin(angle)"
      },
      "r": 7,
      "fill": "#dc2626",
      "stroke": "#991b1b",
      "strokeWidth": 2
    },
    {
      "id": "radius",
      "type": "line",
      "x1": 480,
      "y1": 270,
      "x2": {
        "expr": "480 + 160*Math.cos(angle)"
      },
      "y2": {
        "expr": "270 - 160*Math.sin(angle)"
      },
      "fill": "none",
      "stroke": "#dc2626",
      "strokeWidth": 3
    },
    {
      "id": "tangent",
      "type": "line",
      "x1": {
        "expr": "480 + 160*Math.cos(angle) + 140*Math.sin(angle)"
      },
      "y1": {
        "expr": "270 - 160*Math.sin(angle) + 140*Math.cos(angle)"
      },
      "x2": {
        "expr": "480 + 160*Math.cos(angle) - 140*Math.sin(angle)"
      },
      "y2": {
        "expr": "270 - 160*Math.sin(angle) - 140*Math.cos(angle)"
      },
      "fill": "none",
      "stroke": "#7c3aed",
      "strokeWidth": 3
    },
    {
      "id": "right-angle-a",
      "type": "line",
      "x1": {
        "expr": "480 + 160*Math.cos(angle) - 18*Math.cos(angle)"
      },
      "y1": {
        "expr": "270 - 160*Math.sin(angle) + 18*Math.sin(angle)"
      },
      "x2": {
        "expr": "480 + 160*Math.cos(angle) - 18*Math.cos(angle) - 18*Math.sin(angle)"
      },
      "y2": {
        "expr": "270 - 160*Math.sin(angle) + 18*Math.sin(angle) - 18*Math.cos(angle)"
      },
      "fill": "none",
      "stroke": "#059669",
      "strokeWidth": 2.5
    },
    {
      "id": "right-angle-b",
      "type": "line",
      "x1": {
        "expr": "480 + 160*Math.cos(angle) - 18*Math.sin(angle)"
      },
      "y1": {
        "expr": "270 - 160*Math.sin(angle) - 18*Math.cos(angle)"
      },
      "x2": {
        "expr": "480 + 160*Math.cos(angle) - 18*Math.cos(angle) - 18*Math.sin(angle)"
      },
      "y2": {
        "expr": "270 - 160*Math.sin(angle) + 18*Math.sin(angle) - 18*Math.cos(angle)"
      },
      "fill": "none",
      "stroke": "#059669",
      "strokeWidth": 2.5
    },
    {
      "id": "title",
      "type": "text",
      "x": 32,
      "y": 44,
      "fontSize": 22,
      "fill": "#0f172a",
      "stroke": "none",
      "text": "Tangent is perpendicular to the radius",
      "anchor": "start",
      "fontWeight": 600
    },
    {
      "id": "caption",
      "type": "text",
      "x": 32,
      "y": 512,
      "fontSize": 15,
      "fill": "#475569",
      "stroke": "none",
      "text": "The tangent touches only at P; as the angle changes, the right angle stays 90°.",
      "anchor": "start"
    },
    {
      "id": "point-label",
      "type": "text",
