      "label": "Point angle"
    }
  ],
  "checkpoints": [
    {
      "id": "cp-angle",
      "at": 2.8,
      "title": "Predict the angle",
      "body": "As P moves around the circle, does the angle between the tangent and the radius stay 90°, or only at this starting point?",
      "pause": true,
      "learnerAction": "answer"
    },
    {
      "id": "cp-why",
      "at": 5.2,
      "title": "Explain the invariance",
      "body": "If the radius rotates by 30°, how much does the tangent rotate? Why?",
      "pause": true,
      "learnerAction": "answer"
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "Start with the radius from the center to point P on the unit circle."
    },
    {
      "at": 1.5,
      "text": "The tangent is the line through P perpendicular to that radius; the green marker records the right angle."
    },
    {
      "at": 3.4,
      "text": "As the point angle changes, the radius rotates and the tangent rotates with it, so the 90° relation is preserved."
    },
    {
      "at": 5.8,
      "text": "The tangent touches the circle only at P, which is why the perpendicular direction is forced rather than accidental."
    }
  ],
  "fallback": {
    "text": "At every point on a unit circle, the radius points from the center to that point. The tangent is the line through that point perpendicular to the radius, so the angle between them is a right angle. As the point moves around the circle, both lines rotate together and the right angle stays 90 degrees. The tangent touches the circle only at the chosen point, not at a second nearby point."
  },
  "accessibility": {
    "alt": "Unit circle with a radius from the center to a movable point and a straight tangent through that point; a right-angle marker stays at their intersection as the angle changes.",
    "reducedMotion": "static",
    "keyboard": true
  }
