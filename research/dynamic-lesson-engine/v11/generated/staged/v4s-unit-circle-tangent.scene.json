        "expr": "480 + 160*Math.cos(angle) + 14"
      },
      "y": {
        "expr": "270 - 160*Math.sin(angle) - 14"
      },
      "fontSize": 16,
      "fill": "#b91c1c",
      "stroke": "none",
      "text": "P",
      "anchor": "start",
      "fontWeight": 600
    }
  ],
