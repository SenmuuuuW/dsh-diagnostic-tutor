{
  "version": "0.1",
  "viewport": {
    "width": 960,
    "height": 540,
    "background": "#ffffff"
  },
  "metadata": {
    "title": "Updating a Positive Test: Bayes' Rule",
    "subject": "Statistics",
    "topic": "Bayes' Rule",
    "objective": "Show how a positive test depends on base rate and sensitivity, not just test accuracy.",
    "learner": "Knows conditional probability informally.",
    "misconceptions": [
      "A 99% sensitive test means a 99% chance of disease after a positive result.",
      "The base rate can be ignored because test accuracy dominates."
    ],
    "expectedUnderstanding": [
      "The posterior probability combines the prior (base rate) with the test likelihood.",
      "A high sensitivity can still produce a modest posterior when the condition is rare and false positives are common.",
      "The denominator must include everyone who tests positive, both true positives and false positives."
    ]
  },
  "properties": [
    {
      "id": "prevalence",
      "label": "Prevalence (prior probability)",
      "min": 0.001,
      "max": 0.5,
      "step": 0.001,
      "default": 0.01
    },
    {
      "id": "sensitivity",
      "label": "Sensitivity",
      "min": 0.5,
      "max": 1,
      "step": 0.01,
      "default": 0.99
    },
    {
      "id": "falsePositiveRate",
      "label": "False-positive rate",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "default": 0.05
    }
  ],
