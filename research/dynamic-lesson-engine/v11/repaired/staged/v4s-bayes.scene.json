      "x": 80,
      "y": 280,
      "fontSize": 15,
      "fill": "#334155",
      "stroke": "none",
      "text": "Everyone who tests positive",
      "anchor": "start",
      "fontWeight": 600
    },
    {
      "id": "posterior-true-positive-block",
      "type": "rect",
      "x": 80,
      "y": 292,
      "width": {
        "expr": "700*((prevalence*sensitivity)/(prevalence*sensitivity + (1-prevalence)*falsePositiveRate))"
      },
      "height": 64,
      "rx": 3,
      "fill": "#dc2626",
      "stroke": "#991b1b",
      "strokeWidth": 1
    },
    {
      "id": "posterior-false-positive-block",
      "type": "rect",
      "x": {
        "expr": "80 + 700*((prevalence*sensitivity)/(prevalence*sensitivity + (1-prevalence)*falsePositiveRate))"
      },
      "y": 292,
      "width": {
        "expr": "700*(1 - (prevalence*sensitivity)/(prevalence*sensitivity + (1-prevalence)*falsePositiveRate))"
      },
      "height": 64,
      "rx": 3,
      "fill": "#f59e0b",
      "stroke": "#b45309",
      "strokeWidth": 1
    },
    {
      "id": "posterior-caption",
      "type": "text",
      "x": 80,
      "y": 382,
      "fontSize": 14,
      "fill": "#475569",
      "stroke": "none",
      "text": "Posterior = true positives ÷ everyone who tests positive",
      "anchor": "start"
    },
    {
      "id": "caption",
      "type": "text",
      "x": 32,
      "y": 516,
      "fontSize": 14,
      "fill": "#475569",
      "stroke": "none",
      "text": "High sensitivity can still yield a low posterior when the condition is rare; false positives fill the bar.",
      "anchor": "start"
    }
  ],
