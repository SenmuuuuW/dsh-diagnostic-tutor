      "fill": "#f59e0b",
      "stroke": "#b45309",
      "strokeWidth": 1
    },
    {
      "id": "true-negative-block",
      "type": "rect",
      "x": {
        "expr": "80 + 700*prevalence + 700*(1-prevalence)*falsePositiveRate"
      },
      "y": 134,
      "width": {
        "expr": "700*(1-prevalence)*(1-falsePositiveRate)"
      },
      "height": 58,
      "rx": 3,
      "fill": "#e2e8f0",
      "stroke": "#94a3b8",
      "strokeWidth": 1
    },
    {
      "id": "positive-tests-label",
