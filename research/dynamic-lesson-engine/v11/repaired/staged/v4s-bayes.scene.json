  "checkpoints": [
    {
      "id": "cp-posterior",
      "at": 4.6,
      "title": "Estimate the posterior",
      "body": "At 1% prevalence, 99% sensitivity, and a 5% false-positive rate, roughly what share of positive tests are true positives: about 17%, 50%, or 99%?",
      "pause": true,
      "learnerAction": "answer"
    },
    {
      "id": "cp-base-rate",
      "at": 6.2,
      "title": "Raise the base rate",
      "body": "Before moving prevalence, predict how the red share of the lower bar changes when the condition becomes common.",
      "pause": true,
      "learnerAction": "answer"
    }
  ],
  "narration": [
    {
      "at": 0,
      "text": "The top bar shows all 10,000 people, split by disease status and test result."
    },
    {
      "at": 2,
      "text": "Most people are healthy, so even a small false-positive rate creates many false positives."
    },
    {
      "at": 3.8,
      "text": "The lower bar keeps only positive tests; the red share is the posterior probability of disease."
    },
    {
      "at": 5.2,
      "text": "At the default numbers, the posterior is about 17%, not 99%, because true positives are compared with all positives."
    },
    {
      "at": 6.8,
      "text": "Raising the base rate increases the posterior; this is a probability model, not an individual diagnosis."
    }
  ],
  "fallback": {
    "text": "Start with a population of 10,000 people and a prevalence of 1%, so about 100 people have the condition. With 99% sensitivity, about 99 of them test positive. Of the 9,900 people without the condition, a 5% false-positive rate produces about 495 positive tests. The posterior probability is therefore 99 divided by 99 plus 495, which is about 16.7%. A positive result is evidence, but the large healthy group can generate many false positives; the base rate matters."
  },
  "accessibility": {
    "alt": "A 10,000-person grid shows a small diseased group and a large healthy group; positive-test blocks are highlighted, making the many false positives from the large healthy group comparable to the true positives as prevalence changes.",
    "reducedMotion": "static",
    "keyboard": true
  }
